{
  "name": "@sparkles-rdf/client",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kclejeune/sparkles.git",
    "directory": "js/client"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/openapi.d.ts', 'dist/openapi.d.ts')\""
  },
  "dependencies": {
    "@sparkles-rdf/common": "workspace:*",
    "openapi-fetch": "0.17.0",
    "@rdfjs/types": "2.0.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
