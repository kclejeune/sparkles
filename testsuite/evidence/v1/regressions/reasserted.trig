ex:newDefault rdf:reifies <<(ex:s ex:p ex:o)>> ; prov:wasGeneratedBy ex:b .
ex:a prov:wasAssociatedWith ex:person . ex:b prov:wasAssociatedWith ex:person .
ex:g { ex:s ex:p ex:o .
ex:oldNamed rdf:reifies <<(ex:s ex:p ex:o)>> ; prov:wasGeneratedBy ex:a ; prov:wasInvalidatedBy ex:retraction .
ex:newNamed rdf:reifies <<(ex:s ex:p ex:o)>> ; prov:wasGeneratedBy ex:b .
