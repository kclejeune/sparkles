PREFIX ex: <urn:example:a01:>
PREFIX sr: <urn:x-sparkles:representation:>
PREFIX ev: <urn:x-sparkles:evidence:>
PREFIX vt: <urn:x-sparkles:valid-time:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
ex:A2:person a sr:Entity ; sr:profileVersion 1 ; sr:domainScope ex:A2 ; sr:entityKind sr:Person .
ex:A2:account a sr:Entity ; sr:profileVersion 1 ; sr:domainScope ex:A2 ; sr:entityKind sr:Account .
ex:A2:control:claim a ev:Claim ; rdf:reifies <<( ex:A2:person sr:ControlsAccount ex:A2:account )>> ; ev:claimKind ev:Reported ; ev:polarity ev:Positive ; prov:wasDerivedFrom ex:r1 ; prov:wasGeneratedBy ex:import ; prov:wasAttributedTo ex:author .
ex:A2:control:role a sr:RoleAssignment ; sr:profileVersion 1 ; sr:participant ex:A2:person ; sr:role ex:accountController .
ex:A2:control a sr:Relation ; sr:profileVersion 1 ; sr:domainScope ex:A2 ; sr:subject ex:A2:person ; sr:relationKind sr:ControlsAccount ; sr:object ex:A2:account ; sr:claim ex:A2:control:claim ; sr:roleAssignment ex:A2:control:role .
