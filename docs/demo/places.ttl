# -------------------------------------------------------------------------- countries ----
# Labels only, except Switzerland, which has a rough outline.

place:portugal a ex:Country ; rdfs:label "Portugal"@en, "Portugal"@pt .
place:spain a ex:Country ; rdfs:label "Spain"@en, "España"@es .
place:france a ex:Country ; rdfs:label "France"@en, "France"@fr .
place:united-kingdom a ex:Country ; rdfs:label "United Kingdom"@en .
place:ireland a ex:Country ; rdfs:label "Ireland"@en, "Éire"@ga .
place:netherlands a ex:Country ; rdfs:label "Netherlands"@en, "Nederland"@nl .
place:belgium a ex:Country ; rdfs:label "Belgium"@en, "Belgique"@fr, "België"@nl .
place:germany a ex:Country ; rdfs:label "Germany"@en, "Deutschland"@de .
place:denmark a ex:Country ; rdfs:label "Denmark"@en, "Danmark"@da .
place:sweden a ex:Country ; rdfs:label "Sweden"@en, "Sverige"@sv .
place:finland a ex:Country ; rdfs:label "Finland"@en, "Suomi"@fi .
place:italy a ex:Country ; rdfs:label "Italy"@en, "Italia"@it .
place:austria a ex:Country ; rdfs:label "Austria"@en, "Österreich"@de .
place:czechia a ex:Country ; rdfs:label "Czechia"@en, "Česko"@cs .
place:poland a ex:Country ; rdfs:label "Poland"@en, "Polska"@pl .

place:switzerland a ex:Country ;
    rdfs:label "Switzerland"@en, "Schweiz"@de, "Suisse"@fr, "Svizzera"@it ;
    ex:population 8900000 ;
    geo:hasDefaultGeometry place:switzerland-geom .
place:switzerland-geom a geo:Geometry ;
    geo:asWKT "POLYGON((5.96 46.13, 6.80 46.43, 7.04 45.93, 7.86 45.92, 8.44 46.46, 9.04 45.84, 9.48 46.37, 10.47 46.55, 10.49 46.93, 9.56 47.06, 9.62 47.52, 8.56 47.80, 7.59 47.58, 6.85 47.10, 5.96 46.13))"^^geo:wktLiteral .

# ---------------------------------------------------------------------------- regions ----

place:randstad a ex:Region ;
    rdfs:label "Randstad"@en ;
    rdfs:comment "The conurbation of Amsterdam, Rotterdam, The Hague and Utrecht."@en ;
    ex:population 8400000 ;
    geo:hasDefaultGeometry place:randstad-geom .
place:randstad-geom a geo:Geometry ;
    geo:asWKT "POLYGON((4.20 52.08, 4.50 52.45, 4.95 52.48, 5.25 52.22, 5.20 52.02, 4.85 51.84, 4.35 51.86, 4.20 52.08))"^^geo:wktLiteral .

# ----------------------------------------------------------------------------- routes ----

place:eurostar a ex:Route ;
    rdfs:label "Eurostar London–Paris"@en ;
    ex:connects place:london, place:paris ;
    ex:lengthKm 492.0 ;
    geo:hasDefaultGeometry place:eurostar-geom .
place:eurostar-geom a geo:Geometry ;
    geo:asWKT "LINESTRING(-0.1262 51.5315, 0.8740 51.1430, 1.8100 50.9000, 3.0750 50.6390, 2.3553 48.8809)"^^geo:wktLiteral .

place:oresund-line a ex:Route ;
    rdfs:label "Copenhagen–Stockholm rail link"@en ;
    ex:connects place:copenhagen, place:stockholm ;
    ex:lengthKm 650.0 ;
    geo:hasDefaultGeometry place:oresund-line-geom .
place:oresund-line-geom a geo:Geometry ;
    geo:asWKT "LINESTRING(12.5683 55.6761, 13.0038 55.6050, 13.7700 56.1600, 14.5500 56.9000, 14.7000 57.6500, 15.6200 58.4100, 16.1900 58.5900, 17.6300 59.2000, 18.0686 59.3293)"^^geo:wktLiteral .
