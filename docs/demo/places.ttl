# Places of the demo dataset (see vocab.ttl): European cities as points, two areas as
# polygons and two rail links as lines, in WKT (longitude latitude, CRS84). Coordinates,
# outlines and populations are approximate.

@prefix ex: <http://example.org/ns#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix place: <http://example.org/place/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ----------------------------------------------------------------------------- cities ----

place:lisbon a ex:City ;
    rdfs:label "Lisbon"@en, "Lisboa"@pt ;
    ex:country place:portugal ;
    ex:population 545000 ;
    geo:hasDefaultGeometry place:lisbon-geom .
place:lisbon-geom a geo:Geometry ; geo:asWKT "POINT(-9.1393 38.7223)"^^geo:wktLiteral .

place:madrid a ex:City ;
    rdfs:label "Madrid"@en ;
    ex:country place:spain ;
    ex:population 3330000 ;
    ex:elevation 667.0 ;
