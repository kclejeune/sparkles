# People and organisations of the demo dataset (see vocab.ttl). Everyone and everything
# here is fictional. Three records carry the kind of mistakes the ShEx schema (network.shex)
# is there to catch: Tomasz Kowalski's birth date is a plain string, Omar Haddad has no
# foaf:name, and Corvid Labs reports zero employees.

@prefix ex: <http://example.org/ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix orgs: <http://example.org/org/> .
@prefix person: <http://example.org/person/> .
@prefix place: <http://example.org/place/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------- organisations ----

orgs:helix-institute a ex:ResearchInstitute ;
    rdfs:label "Helix Institute for Computational Biology"@en ;
    rdfs:comment "Protein structure prediction and genome-scale models."@en ;
    ex:founded "1998"^^xsd:gYear ;
    ex:employees 310 ;
    ex:headquarters place:zurich ;
    ex:website <https://helix.example/> ;
    ex:partnerOf orgs:lumen-university, orgs:meridian-health .

orgs:lumen-university a ex:University ;
    rdfs:label "Lumen University"@en, "Universiteit Lumen"@nl ;
    rdfs:comment "A research university with strong computer science and linguistics."@en ;
    ex:founded "1921"^^xsd:gYear ;
    ex:employees 5400 ;
    ex:headquarters place:amsterdam ;
    ex:website <https://lumen.example/> ;
    ex:partnerOf orgs:vltava-institute .

orgs:aurora-polytechnic a ex:University ;
    rdfs:label "Aurora Polytechnic"@en, "Aurora-ammattikorkeakoulu"@fi ;
    ex:founded "1972"^^xsd:gYear ;
    ex:employees 2100 ;
    ex:headquarters place:helsinki ;
    ex:website <https://aurora.example/> ;
    ex:partnerOf orgs:northwind-robotics .

orgs:vltava-institute a ex:ResearchInstitute ;
    rdfs:label "Vltava Institute of Linguistics"@en, "Vltavský lingvistický ústav"@cs ;
    ex:founded "1953"^^xsd:gYear ;
    ex:employees 140 ;
    ex:headquarters place:prague ;
    ex:website <https://vltava.example/> .

orgs:northwind-robotics a ex:Company ;
    rdfs:label "Northwind Robotics"@en ;
    rdfs:comment "Autonomous logistics robots for warehouses and ports."@en ;
    ex:founded "2011"^^xsd:gYear ;
    ex:employees 240 ;
    ex:headquarters place:copenhagen ;
    ex:website <https://northwind.example/> .

orgs:meridian-health a ex:Company ;
    rdfs:label "Meridian Health Analytics"@en ;
    ex:founded "2008"^^xsd:gYear ;
    ex:employees 410 ;
    ex:headquarters place:milan ;
    ex:website <https://meridian.example/> .

orgs:kestrel-energy a ex:Company ;
    rdfs:label "Kestrel Energy"@en ;
    rdfs:comment "Offshore wind forecasting and grid storage."@en ;
    ex:founded "2013"^^xsd:gYear ;
    ex:employees 180 ;
    ex:headquarters place:edinburgh ;
    ex:website <https://kestrel.example/> ;
    ex:partnerOf orgs:aurora-polytechnic .

orgs:tessellate a ex:Startup ;
    rdfs:label "Tessellate Maps"@en ;
    rdfs:comment "Vector tiles and spatial search for the open web."@en ;
    ex:founded "2018"^^xsd:gYear ;
    ex:employees 36 ;
    ex:headquarters place:berlin ;
    ex:website <https://tessellate.example/> ;
    ex:partnerOf orgs:atlas-open-data .

orgs:corvid-labs a ex:Startup ;
    rdfs:label "Corvid Labs"@en ;
    rdfs:comment "Knowledge graphs for small newsrooms."@en ;
    ex:founded "2021"^^xsd:gYear ;
    ex:employees 0 ;
    ex:headquarters place:lisbon ;
    ex:website <https://corvid.example/> .

orgs:atlas-open-data a ex:Nonprofit ;
    rdfs:label "Atlas Open Data Foundation"@en, "Fondation Atlas Open Data"@fr ;
    rdfs:comment "Publishes public-sector data as linked open data."@en ;
    ex:founded "2009"^^xsd:gYear ;
    ex:employees 22 ;
    ex:headquarters place:brussels ;
    ex:website <https://atlas.example/> .

