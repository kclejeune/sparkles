PREFIX ex: <http://example.org/> PREFIX foaf: <http://xmlns.com/foaf/0.1/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT ?e (COUNT(*) AS ?c) WHERE { ?p a ex:Student ; ex:advisor ?a BIND(NOT EXISTS { ?a ex:worksFor ?o . ?o ex:city "Kyoto" } AS ?e) } GROUP BY ?e