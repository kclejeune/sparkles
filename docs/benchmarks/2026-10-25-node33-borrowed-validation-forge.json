  "drivers": {
    "primary": "import {performance} from 'node:perf_hooks';\nimport {readFileSync} from 'node:fs';\nimport {Dataset, factory} from './js/engine/dist/index.js';\nconst ds=Dataset.memory();\nawait ds.loadFiles([new URL('./data.nt',import.meta.url).pathname]);\nconst datasetRows=Number(await ds.count());\nconst iri=factory.namedNode;\nconst rdfType=iri('http://www.w3.org/1999/02/22-rdf-syntax-ns#type');\nconst probes=JSON.parse(readFileSync(new URL('./probes.json',import.meta.url),'utf8')).map(([s,t])=>factory.quad(iri(s),rdfType,iri(t)));\nlet sink=0;\nlet probeHits=0;for(const q of probes) probeHits+=Number(await ds.has(q));\nif(probes.length!==1000 || probeHits!==500) throw new Error(`probe mismatch ${probes.length}/${probeHits}`);\nconst report=(name,ops,ms,extra={})=>console.log(JSON.stringify({name,ops,ms,usPerOp:ms*1000/ops,...extra}));\nconst timed=async(name,ops,fn)=>{global.gc?.();const start=performance.now();await fn();report(name,ops,performance.now()-start);};\nfor(let i=0;i<10000;i++)sink+=Number(await ds.has(probes[i%1000]));\nconst reps=2000000;\nawait timed('has-api',reps,async()=>{for(let i=0;i<reps;i++)sink+=Number(await ds.has(probes[i%1000]));});\nawait timed('term-encoding',reps,async()=>{for(let i=0;i<reps;i++)sink+=ds.terms.encodeQuad(probes[i%1000]).data[1];});\nconst requests=probes.map(q=>{const {text,data}=ds.terms.encodeQuad(q);return {text,data:data.slice(0,4+4*data[1]+4*data[2])};});\nawait timed('native-contains',reps,async()=>{for(let i=0;i<reps;i++){const r=requests[i%1000];sink+=Number(ds.handle.containsTerms(r.text,r.data));}});\nconst query='SELECT ?s ?name WHERE { VALUES ?s {<http://example.org/person/0> <http://example.org/person/10> <http://example.org/person/20> <http://example.org/person/30> <http://example.org/person/40>} ?s <http://xmlns.com/foaf/0.1/name> ?name }';\nlet selected=0;\nawait timed('small-select-all-terms',500,async()=>{for(let i=0;i<500;i++){const r=await ds.query(query,{noCache:true});for await(const row of r){selected++;sink+=row.get('s').value.length+row.get('name').value.length;}}});\nif(selected!==2500)throw new Error(`SELECT rows ${selected}`);\nconst exportQuery='SELECT ?s ?p ?o WHERE {?s ?p ?o}';\nfor(const decode of [false,true]){\n let rows=0;const start=performance.now();\n for(let i=0;i<15;i++){const r=await ds.query(exportQuery,{noCache:true});for await(const row of r){rows++;if(decode)for(const key of ['s','p','o']){const t=row.get(key);sink+=t.value.length;if(t.termType==='Literal')sink+=t.datatype.value.length+t.language.length;}}}\n if(rows!==15*datasetRows)throw new Error(`export rows ${rows} expected ${15*datasetRows}`);\n report(decode?'export-all-terms':'export-count-only',rows,performance.now()-start);\n}\nconst fresh=factory.namedNode('http://example.org/fresh');\nawait timed('write-reused-subject-predicate-fresh-literal',10000,async()=>{await ds.transaction(async tx=>{for(let i=0;i<10000;i++)await tx.add(factory.quad(iri(`http://example.org/person/${i%100}`),fresh,factory.literal(String(i))));});});\nconst writtenRows=Number(await ds.count());if(writtenRows!==datasetRows+10000)throw new Error(`write rows ${writtenRows}`);\nfor(let i=0;i<1000;i++){const d=Dataset.memory();await d.close();}\nfor(let round=0;round<10;round++) await timed('dataset-memory-birth-close',1000,async()=>{for(let i=0;i<1000;i++){const d=Dataset.memory();await d.close();}});\nawait ds.close();\nconsole.log(JSON.stringify({name:'completed',sink,node:process.version,rows:datasetRows}));\n",
    "focused": "import {performance} from 'node:perf_hooks';\nimport {Dataset} from './js/engine/dist/index.js';\nconst ds=Dataset.memory();\nawait ds.loadFiles([new URL('./data.nt',import.meta.url).pathname]);\nconst rows=Number(await ds.count());\nconst query='SELECT ?s ?name WHERE { VALUES ?s {<http://example.org/person/0> <http://example.org/person/10> <http://example.org/person/20> <http://example.org/person/30> <http://example.org/person/40>} ?s <http://xmlns.com/foaf/0.1/name> ?name }';\nlet sink=0;\nasync function small(n){let selected=0;for(let i=0;i<n;i++){const r=await ds.query(query,{noCache:true});for await(const row of r){selected++;sink+=row.get('s').value.length+row.get('name').value.length;}}if(selected!==n*5)throw Error(`SELECT ${selected}`);}\nconst report=(name,ops,start)=>{const ms=performance.now()-start;console.log(JSON.stringify({name,ops,ms,usPerOp:ms*1000/ops}));};\nawait small(1000);\nfor(let i=0;i<5;i++){global.gc();const start=performance.now();await small(2000);report('small-select-all-terms',2000,start);}\nfor(const decode of [false,true]){\n const warm=await ds.query('SELECT ?s ?p ?o WHERE {?s ?p ?o}',{noCache:true});for await(const row of warm)if(decode)for(const k of ['s','p','o'])sink+=row.get(k).value.length;\n for(let i=0;i<5;i++){\n  global.gc();let seen=0;const start=performance.now();\n  for(let round=0;round<3;round++){const r=await ds.query('SELECT ?s ?p ?o WHERE {?s ?p ?o}',{noCache:true});for await(const row of r){seen++;if(decode)for(const k of ['s','p','o']){const t=row.get(k);sink+=t.value.length;if(t.termType==='Literal')sink+=t.datatype.value.length+t.language.length;}}}\n  if(seen!==rows*3)throw Error(`export ${seen}`);\n  report(decode?'export-all-terms':'export-count-only',seen,start);\n }\n}\nawait ds.close();console.log(JSON.stringify({name:'completed',rows,sink,node:process.version}));\n"
  },
  "limits": "Hot probes use1000 cached terms with50percent hits. Writes reuse100subjects and one predicate with10000 fresh literals in one transaction. SELECT returns5rows and disables the plan cache. Export reads105300unique rows with count-only and full term consumption. Lifecycle measures empty in-memory dataset creation and close, not the DBpedia births query. Small SELECT changes direction with large process variation; exports vary by about1.5percent. Roadmap329 retains these unresolved controls. No peer-engine comparison or closure of item33 is claimed."
