# The SHACL 1.2 list constraint tests vendored from the Data Shapes Working Group's test
# suite (see README.md). Written for Sparkles; the included files are unchanged.
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<> rdf:type mf:Manifest ;
    mf:include <core/node/memberShape-001.ttl> ,
        <core/node/minListLength-001.ttl> ,
        <core/node/maxListLength-001.ttl> ,
        <core/node/uniqueMembers-001.ttl> ,
        <core/property/memberShape-001.ttl> ,
        <core/property/minListLength-001.ttl> ,
        <core/property/maxListLength-001.ttl> ,
        <core/property/uniqueMembers-001.ttl> .
