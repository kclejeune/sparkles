PREFIX ev: <urn:x-sparkles:evidence:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX oa: <http://www.w3.org/ns/oa#>

SELECT ?claim ?proposition ?kind ?polarity ?revision ?author WHERE {
  ?claim a ev:Claim ; rdf:reifies ?proposition ; ev:claimKind ?kind ;
    ev:polarity ?polarity ; prov:wasDerivedFrom ?revision ; prov:wasAttributedTo ?author .
} ORDER BY ?claim
