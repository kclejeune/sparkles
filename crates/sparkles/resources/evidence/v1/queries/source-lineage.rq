PREFIX ev: <urn:x-sparkles:evidence:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX oa: <http://www.w3.org/ns/oa#>

SELECT ?revision ?source ?upstream ?family ?lineageStatus WHERE {
  ?revision a ev:SourceRevision ; prov:specializationOf ?source .
  OPTIONAL { ?revision ev:upstreamSource ?upstream }
  OPTIONAL { ?revision ev:sourceFamily ?family }
  BIND(IF(BOUND(?upstream) || BOUND(?family), "declared lineage", "unknown") AS ?lineageStatus)
} ORDER BY ?revision
