  sh:property [ sh:path sr:fromVersion ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;  ] ;
  sh:property [ sh:path sr:toVersion ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;  ] ;
  sh:property [ sh:path sr:method ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;  ] ;
  sh:property [ sh:path sr:inputManifest ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sr:InputManifest ;  ] ;
  sh:property [ sh:path sr:generatedRecord ; sh:nodeKind sh:IRI ; sh:minCount 1 ;  ] .

sr:DenominatorShape a sh:NodeShape ;
  sh:targetClass sr:Denominator ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties (rdf:type rdfs:label) ;
  sh:property [ sh:path sr:profileVersion ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue 1 ] ;
  sh:property [ sh:path sr:extension ; sh:nodeKind sh:IRI ; sh:class sr:Extension ;  ] ;
  sh:property [ sh:path sr:denominatorValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path sr:unit ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;  ] ;
  sh:property [ sh:path sr:population ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;  ] ;
  sh:property [ sh:path sr:observedDuring ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ; sh:class vt:Interval ;  ] .

sr:ExtensionShape a sh:NodeShape ;
  sh:targetClass sr:Extension ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties (rdf:type rdfs:label) ;
  sh:property [ sh:path sr:profileVersion ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue 1 ] ;
  sh:property [ sh:path sr:extension ; sh:nodeKind sh:IRI ; sh:class sr:Extension ;  ] ;
  sh:property [ sh:path sr:extensionProfile ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;  ] ;
  sh:property [ sh:path sr:payloadDigest ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^sha256:[0-9a-f]{64}$" ] ;
  sh:property [ sh:path sr:status ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (sr:Uninterpreted) ;  ] .

sr:InputManifestShape a sh:NodeShape ;
  sh:targetClass sr:InputManifest ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties (rdf:type rdfs:label) ;
  sh:property [ sh:path sr:profileVersion ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue 1 ] ;
  sh:property [ sh:path sr:extension ; sh:nodeKind sh:IRI ; sh:class sr:Extension ;  ] ;
  sh:property [ sh:path sr:inputId ; sh:nodeKind sh:IRI ; sh:minCount 1 ;  ] ;
  sh:property [ sh:path sr:requiredExtension ; sh:nodeKind sh:IRI ;  ] ;
  sh:sparql [ sh:message "Version 1 has no adopted required extension profiles." ; sh:select """PREFIX sr: <urn:x-sparkles:representation:>
PREFIX ev: <urn:x-sparkles:evidence:>
PREFIX vt: <urn:x-sparkles:valid-time:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT $this WHERE { $this sr:requiredExtension ?extension }""" ] .

sr:PolicyShape a sh:NodeShape ;
  sh:targetClass sr:Policy ;
  sh:nodeKind sh:IRI ;
  sh:closed true ;
  sh:ignoredProperties (rdf:type rdfs:label) ;
  sh:property [ sh:path sr:profileVersion ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue 1 ] ;
  sh:property [ sh:path sr:extension ; sh:nodeKind sh:IRI ; sh:class sr:Extension ;  ] ;
  sh:property [ sh:path sr:separationRule ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (sr:PairwiseSeparation) ;  ] ;
  sh:property [ sh:path sr:conflictRule ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (sr:WholeComponentConflict) ;  ] ;
  sh:property [ sh:path sr:kindRule ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (sr:ExactKind) ;  ] ;
  sh:property [ sh:path sr:representativeRule ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (sr:LeastUtf8Iri) ;  ] ;
  sh:property [ sh:path sr:stringRule ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (sr:ScalarJson1) ;  ] .

