PREFIX sr: <urn:x-sparkles:representation:>
PREFIX ev: <urn:x-sparkles:evidence:>
PREFIX vt: <urn:x-sparkles:valid-time:>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
# Run against one explicitly authorized recorded view. No query admits claims.
SELECT ?identification ?identifier ?authority ?realm ?identifierScope ?lexicalValue ?entity ?claim ?validity WHERE {
  ?identification a sr:Identification ; sr:identifier ?identifier ; sr:entity ?entity ; sr:claim ?claim .
  ?identifier sr:authority ?authority ; sr:realm ?realm ; sr:identifierScope ?identifierScope ; sr:lexicalValue ?lexicalValue .
  OPTIONAL { ?identification vt:validDuring ?validity }
}
