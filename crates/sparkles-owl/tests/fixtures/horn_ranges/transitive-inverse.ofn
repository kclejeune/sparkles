SubObjectPropertyOf(:p :ri)
SubClassOf(:L ObjectHasSelf(:p))
SubClassOf(:K ObjectSomeValuesFrom(:r ObjectSomeValuesFrom(:r :B)))
EquivalentClasses(:Z ObjectSomeValuesFrom(:r ObjectSomeValuesFrom(:r ObjectIntersectionOf(:B :C))))
)
