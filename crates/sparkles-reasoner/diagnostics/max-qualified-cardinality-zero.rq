# max-qualified-cardinality-zero: an instance of a restriction with
# owl:maxQualifiedCardinality 0 that has a value of the qualifying class for the
# restricted property (OWL 2 RL cls-maxqc1). With owl:onClass owl:Thing, any value
# counts (cls-maxqc2).
#
# The cardinality is compared by value, so 0 written as xsd:integer counts as well.
# {TYPE} is replaced by `rdf:type` (closure=none) or `rdf:type/rdfs:subClassOf*`
# (closure=subclass); the checker appends a LIMIT.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT DISTINCT ?r ?x ?p ?c ?y WHERE {
  ?r owl:maxQualifiedCardinality ?n ;
     owl:onProperty ?p ;
     owl:onClass ?c .
  FILTER(isNumeric(?n) && ?n = 0)
  ?x {TYPE} ?r .
  ?x ?p ?y .
  FILTER(?c = owl:Thing || EXISTS { ?y {TYPE} ?c })
}
