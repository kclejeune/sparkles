<#1dotExtendsInverse_pass> a sht:ValidationTest ;
    mf:name "1dotExtendsInverse_pass" ;
    sht:trait sht:TriplePattern , sht:Inverse , sht:Extends ;
    rdfs:comment "<B>{ <p1> . } <A> EXTENDS @<B> { ^<p2> . } on { <s1> <p1> <o1>. <n0> <p2> <s1> }" ;
    mf:status mf:Approved ;
    mf:action [
      sht:schema <../schemas/1dotExtendsInverse.shex> ;
      sht:shape <http://a.example/A> ;
      sht:data <Is1_Ip1_Io1.In0_Ip2_Is1.ttl> ;
      sht:focus <http://a.example/s1>
    ]
    .

<#1dot2SameExtends_pass> a sht:ValidationTest ;
    mf:name "1dot2SameExtends_pass" ;
    sht:trait sht:Extends , sht:MultiExtends ;
    rdfs:comment "naming the same parent twice: <B>{ <p2> . } <A> EXTENDS @<B> EXTENDS @<B> { <p1> . } on { <s1> <p1> <o1>; <p2> <o2> }" ;
    mf:status mf:Approved ;
    mf:action [
      sht:schema <../schemas/1dot2SameExtends.shex> ;
      sht:shape <http://a.example/A> ;
      sht:data <Is1_Ip1_Io1;Ip2_Io2.ttl> ;
      sht:focus <http://a.example/s1>
    ]
    .

<#1dotExtendsInverse_fail> a sht:ValidationFailure ;
    mf:name "1dotExtendsInverse_fail" ;
    sht:trait sht:TriplePattern , sht:Inverse , sht:Extends ;
    rdfs:comment "<B>{ <p1> . } <A> EXTENDS @<B> { ^<p2> . } on { <s1> <p1> <o1> } (no incoming <p2>)" ;
    mf:status mf:Approved ;
    mf:action [
      sht:schema <../schemas/1dotExtendsInverse.shex> ;
      sht:shape <http://a.example/A> ;
      sht:data <Is1_Ip1_Io1.ttl> ;
      sht:focus <http://a.example/s1>
    ]
    .

<#1dotInverseExtends_pass> a sht:ValidationTest ;
    mf:name "1dotInverseExtends_pass" ;
    sht:trait sht:TriplePattern , sht:Inverse , sht:Extends ;
    rdfs:comment "<B>{ ^<p2> . } <A> EXTENDS @<B> { ^<p1> . } on { <o1> <p1> <s1>. <n0> <p2> <s1> } (<s1> has both an incoming <p1> and an incoming <p2>; the parent's inverse arc must be matched)" ;
    mf:status mf:Approved ;
    mf:action [
      sht:schema <../schemas/1dotInverseExtends.shex> ;
      sht:shape <http://a.example/A> ;
      sht:data <Io1_Ip1_Is1.In0_Ip2_Is1.ttl> ;
      sht:focus <http://a.example/s1>
    ]
    .

<#1dotInverseExtends_fail> a sht:ValidationFailure ;
    mf:name "1dotInverseExtends_fail" ;
    sht:trait sht:TriplePattern , sht:Inverse , sht:Extends ;
    rdfs:comment "<B>{ ^<p2> . } <A> EXTENDS @<B> { ^<p1> . } on { <s1> <p1> <o1> } (<s1> has no incoming <p1> or <p2>)" ;
    mf:status mf:Approved ;
    mf:action [
      sht:schema <../schemas/1dotInverseExtends.shex> ;
      sht:shape <http://a.example/A> ;
      sht:data <Is1_Ip1_Io1.ttl> ;
      sht:focus <http://a.example/s1>
    ]
    .

<#extends-abstract-multi-empty_pass> a sht:ValidationTest ;
    mf:name "extends-abstract-multi-empty_pass" ;
    sht:trait sht:Extends , sht:Abstract , sht:MultiExtends , sht:Closed ;
    rdfs:comment "<Issue> C { ... @<Person> ... @<Employee> } ABS <Person> <User> EXT @<Person> ABS <Rep> <Employee> EXT @<Person> EXT @<Rep> on { <Issue1> ... <User2> ... <Thompson.J> ... } " ;
    mf:status mf:proposed ;
    mf:action [
      sht:schema <../schemas/extends-abstract-multi-empty.shex> ;
      sht:shape <http://a.example/IssueShape> ;
      sht:data <extends-abstract-multi-empty_pass.ttl> ;
      sht:focus <http://a.example/Issue1>
    ] ;
    .

