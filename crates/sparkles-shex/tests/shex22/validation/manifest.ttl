<#ExtendsRepeatedP-pass> a sht:ValidationTest ;
    mf:name "ExtendsRepeatedP-pass" ;
    sht:trait sht:Extends , sht:Exhaustive ;
    rdfs:comment "<A> { :p{2}; :q[3] } <B> @<A>AND{ :p+; :q+ } <C> EXT @<B> { :p } on { :s :p 1,2,3; :q 3 }" ;
    mf:status mf:proposed ;
    mf:action [
        sht:schema <../schemas/ExtendsRepeatedP.shex> ;
        sht:shape <http://a.example/#C> ;
        sht:data <sP123q3.ttl> ;
        sht:focus <http://a.example/s> ;
    ] ;
    .

