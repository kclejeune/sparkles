@base <https://raw.githubusercontent.com/shexSpec/shexTest/master/negativeStructure/manifest> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sht:    <http://www.w3.org/ns/shacl/test-suite#> .
@prefix sx:     <https://shexspec.github.io/shexTest/ns#> .

<> a mf:Manifest ;
    rdfs:comment "ShEx negative structure tests" ;
    mf:entries (
    <#Cycle2ExtendsNegation>
    <#Cycle1Extends>
    <#Cycle2Extends>
    <#Cycle2ExtendsOr>
) .

<#Cycle2ExtendsNegation> a sht:NegativeStructure ;
  mf:name "Cycle2ExtendsNegation" ;
  mf:status mf:Proposed ;
  sx:shex <Cycle2ExtendsNegation.shex> ;
  mf:startRow 5 ;
  mf:startColumn 8 ;
  mf:endRow 5 ;
  mf:endColumn 11 ;
  .

<#Cycle1Extends> a sht:NegativeStructure ;
  mf:name "Cycle1Extends" ;
  mf:status mf:Proposed ;
  sx:shex <Cycle1Extends.shex> ;
  mf:startRow 5 ;
  mf:startColumn 12 ;
  mf:endRow 5 ;
  mf:endColumn 15 ;
  .

<#Cycle2Extends> a sht:NegativeStructure ;
  mf:name "Cycle2Extends" ;
  mf:status mf:Proposed ;
  sx:shex <Cycle2Extends.shex> ;
  mf:startRow 6 ;
  mf:startColumn 12 ;
  mf:endRow 6 ;
  mf:endColumn 15 ;
  .

<#Cycle2ExtendsOr> a sht:NegativeStructure ;
  mf:name "Cycle2ExtendsOr" ;
  mf:status mf:Proposed ;
  sx:shex <Cycle2ExtendsOr.shex> ;
  mf:startRow 15 ;
  mf:startColumn 12 ;
  mf:endRow 15 ;
  mf:endColumn 17 ;
  .
