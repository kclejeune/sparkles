PREFIX ex: <http://example.org/>

# the default graph
{
  ex:a ex:p ex:b .
  ex:c ex:p ex:d .
}

GRAPH ex:g1 {
  ex:a
    ex:p ex:b ;
    ex:q ex:c ;
  .
}

GRAPH ex:g2 {
  # inside
  ex:x ex:y ex:z .
  # last
}

GRAPH _:g3 {}
ex:top ex:p ex:o .

GRAPH [] {
  ex:s
    ex:p [
      ex:q 1 ;
      ex:r 2 ;
    ] ;
  .
}
