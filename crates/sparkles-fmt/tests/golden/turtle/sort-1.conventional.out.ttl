# Sorting: sections are barriers, comments travel with their nodes

PREFIX ex: <http://example.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# --- Things ---

# a blank node subject sorts by its printed form
[ ex:value 1 ] ex:note "one" .
ex:ant ex:legs 6 .

ex:bee a ex:Insect ;
  ex:legs 6 .

ex:zebra a ex:Animal ;
  ex:eats ex:bark, ex:grass ; # mostly grass
  ex:legs 4 ;
  ex:size [
    ex:unit ex:metre ;
    ex:value 2.5
  ] ;
  rdfs:label "Zebra"@de, "zebra"@en, "zèbre"@fr .

# --- Lists keep their order ---

ex:alpha ex:p ex:o .
# sparkles-fmt: ignore
ex:kept   ex:as   "written" .

ex:steps ex:order ( ex:three ex:one ex:two ) ;
  ex:tags
    "b",
    "c", # c is second to last
    "a" .
