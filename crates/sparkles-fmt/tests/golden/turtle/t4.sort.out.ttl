PREFIX ex: <http://example.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Classes

# the root class
ex:Animal
  a rdfs:Class ;
  rdfs:label "Animal" ;
.

ex:Zebra
  rdfs:label "Zebra" ;
  rdfs:subClassOf ex:Animal ;
.

# Properties

ex:age rdfs:domain ex:Animal .

ex:weight
  rdfs:domain ex:Animal ;
  rdfs:label "weight" ;
.
