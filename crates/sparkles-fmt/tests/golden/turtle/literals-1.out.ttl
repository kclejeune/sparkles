PREFIX ex: <http://example.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:s
  ex:int 42, -7, 007 ;
  ex:dec 3.14, "1"^^xsd:decimal, "1."^^xsd:decimal ;
  ex:dbl 1e10, "INF"^^xsd:double ;
  ex:bool true, "1"^^xsd:boolean, false ;
  ex:str "single", "it's", 'say "hi"', "x"^^xsd:string, """long
single""", """long
double""" ;
  ex:lang "chat"@FR, "colour"@en-GB, "שלום"@he--rtl ;
  ex:esc "tab\there", "\u00e9" ;
.
