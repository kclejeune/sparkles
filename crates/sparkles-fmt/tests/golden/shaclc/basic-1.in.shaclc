# Person shapes
# second line

BASE <http://example.com/ns>
IMPORTS <http://example.com/person-ontology>
prefix ex: <http://example.com/ns#>
PREFIX   xsd:<http://www.w3.org/2001/XMLSchema#>
PREFIX unused: <http://example.com/unused#>



SHAPE ex:PersonShape -> ex:Person   ex:Human {
   closed=TRUE ignoredProperties=[rdf:type ex:other]  .
   ex:ssn xsd:string [0..1] pattern="^\\d{3}-\\d{2}-\\d{4}$" . # the ssn

   ex:worksFor IRI [0..*] {
     ex:name xsd:string [1..1] .
   } .
   !minLength=2|maxLength=9 .
   @ex:Other .
   ex:a|ex:b/ex:c* xsd:string|xsd:integer|<http://www.w3.org/2001/XMLSchema#date> [1..*] .
}
shapeclass ex:Person{}
shape ex:Empty{ # nothing here
}
