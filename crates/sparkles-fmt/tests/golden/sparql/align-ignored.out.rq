PREFIX ex: <http://example.org/>

SELECT *
WHERE {
  VALUES (?k ?v) {
    # sparkles-fmt: ignore
    ("a"   1)
    ("bbb" 2)
  }
  VALUES (?k ?text) {
    ("x" """first line
second line""")
    ("yyy" "short")
  }
  VALUES (?a ?b) {
    (<<( ex:s ex:p "o" )>> 1)
    (<<( ex:longer-subject ex:p "o" )>> 22)
  }
}
