PREFIX ex: <http://example.org/>
CONSTRUCT { ?p ex:address [ ex:city ?city ; ex:country ?country ] ; ex:tag [ ex:v 1 ] .
  ?p ex:list ( 1 2 3 ) , ( ) .
  [ ex:p ?o ] .
  [ ex:p ?o ; ex:q ?r ] ex:s ?t .
  ?p ex:many [ ex:a 1 ; ex:b 2 ], [ ex:c 3 ] .
  ?p ex:nested [ ex:inner [ ex:deep 1 ; ex:deeper 2 ] ] .
  ( ex:aVeryLongCollectionItemOne ex:aVeryLongCollectionItemTwo ex:aVeryLongCollectionItemThree ) ex:p 1 .
}
WHERE { ?p ex:city ?city ; ex:country ?country }
