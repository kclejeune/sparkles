PREFIX ex: <http://example.org/>

SELECT ?p ?f ?gp
WHERE {
  ?p a ex:Person ;
    ex:parent{2} ?gp .
  ?p ex:next{1,3}/ex:q{2,} ?x .
  ?x ^ex:r{,4} ?y .
  ?y (ex:a|ex:b){*} ?z .
  ?z ex:c{+} ?w .
  LATERAL {
    SELECT ?p ?f
    WHERE {
      ?p ex:knows ?f .
    }
    ORDER BY ?f
    LIMIT 3
  }
  OPTIONAL {
    LATERAL {
      ?f ex:age ?age .
    }
  }
}
