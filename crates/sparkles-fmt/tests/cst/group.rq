PREFIX ex: <http://example.org/>
SELECT * WHERE {
  ?s ex:p ?o .
  OPTIONAL { ?s ex:q ?q } .
  MINUS { ?s a ex:Hidden }
  { ?s ex:r 1 } UNION { ?s ex:r 2 } UNION { ?s ex:r 3 }
  { ?s ex:alone ?x }
  ?o ex:p ?z
  GRAPH ?g { ?z ex:p ?w }
  SERVICE SILENT <http://example.org/sparql> { ?w ex:p ?v }
  SERVICE ex:endpoint {}
  FILTER(?o != ?z)
  FILTER regex(?v, "x")
  BIND(?v AS ?bound)
  VALUES ?s { ex:a }
  { SELECT ?s WHERE { ?s ex:p ?o } LIMIT 1 }
  {}
}
