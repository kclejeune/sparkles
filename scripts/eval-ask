#!/usr/bin/env python3
"""Run Ask question sets as whole pipelines with strict RDF-term scoring.

This script makes no claim of independent role accuracy or official QALD scores.
Paid Anthropic runs use eval-ask-anthropic, which adds a cost-capped local proxy.
"""

import argparse
import hashlib
import json
import math
import os
import pathlib
import re
import signal
import statistics
import sys
import collections
import contextlib
import queue
import shutil
import subprocess
import tempfile
import threading
import time

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "testsuite/ask/eval_support"))
from evaluator import (
    QUERY_GRACE_SECONDS,
    GoldFault,
    HarnessFault,
    Invalid,
    POLICIES,
    POLICY,
    OfflinePolicy,
    answer_set,
    bounded_file,
    capture_child,
    choose_clarification,
    digest,
    prefix_header,
    finite_positive,
    leaf_environment,
    offline_query,
    parse_child,
    score_sets,
    strict_json,
    validate_ask_record,
)
import guarded
from evaluator import (
    norm_term as norm_term,  # noqa: PLC0414 -- retained scoring import for recomputation
)
from evaluator import (
    prf as prf,  # noqa: PLC0414 -- retained scoring import for recomputation
)

DEFAULT_SET = ROOT / "testsuite/ask/demo.json"
# `answer` answers a clarification of an answerable question from its gold query and
# scores the second Ask. `score` scores the clarification itself as a failure, as the
# first paid run did.
CLARIFICATIONS = ("answer", "score")


def bucket(score):
    if score is None:
        return "unknown"
    return "simple" if score < 4 else "medium" if score < 8 else "complex"


def load_questions(args):
    qset = strict_json(bounded_file(args.set, 4 * 1024 * 1024))
    if (
        not isinstance(qset, dict)
        or not isinstance(qset.get("questions"), list)
        or not (isinstance(qset.get("data"), str) or args.loc)
    ):
        raise Invalid("invalid question set")
    ids = []
    for q in qset["questions"]:
        if (
            not isinstance(q, dict)
            or not isinstance(q.get("id"), str)
            or not q["id"]
            or len(q["id"]) > 200
            or q.get("kind") not in ("answerable", "clarify", "unanswerable")
            or not isinstance(q.get("question"), str)
        ):
            raise Invalid("invalid question")
        if q["kind"] == "answerable" and not isinstance(q.get("gold"), str):
            raise Invalid("answerable question needs gold")
        ids.append(q["id"])
    if len(ids) != len(set(ids)) or not ids:
        raise Invalid("empty or duplicate question IDs")
    if args.only is not None:
        selected = args.only.split(",")
        if len(selected) != len(set(selected)) or not set(selected) <= set(ids):
            raise Invalid("unknown or duplicate --only ID")
        qset = dict(
            qset, questions=[q for q in qset["questions"] if q["id"] in selected]
        )
    if not qset["questions"]:
        raise Invalid("empty question selection")
    if args.loc:
        if not pathlib.Path(args.loc).is_dir():
            raise Invalid("database directory required for --loc")
    else:
        data = (pathlib.Path(args.set).resolve().parent / qset["data"]).resolve()
        if not data.is_file():
            raise Invalid("data file required")
    return qset


def validate_args(args):
    for value in (args.deadline, args.timeout, args.max_tokens):
        finite_positive(value)
    # A phase deadline of zero means none. The run's cost cap and the Ask deadline
    # bound a campaign, so a long matrix is not cut off by a wall-clock limit.
    if args.phase_deadline:
        finite_positive(args.phase_deadline)
    if type(args.jobs) is not int or not 1 <= args.jobs <= 64:
        raise Invalid("--jobs from 1 to 64 required")
    if args.jobs > 1 and not args.batch:
        # Separate processes cannot share a database directory's lock, so cases run
        # at once only inside one batch child.
        raise Invalid("--jobs above 1 needs --batch")
    memory_wrapper(getattr(args, "child_memory_max", None))
    binary = pathlib.Path(args.sparkles)
    if (
        not binary.is_absolute()
        or not binary.is_file()
        or not os.access(binary, os.X_OK)
    ):
        raise Invalid("exact existing absolute --sparkles required; no fallback")
    actual = digest(binary)
    if not args.sparkles_sha256 or args.sparkles_sha256 != actual:
        raise Invalid("exact --sparkles-sha256 required")
    if (
        not args.pair
        or len(set(args.pair)) != len(args.pair)
        or any(p.count("/") != 1 or not all(p.split("/")) for p in args.pair)
    ):
        raise Invalid("unique nonempty provider/model pairs required")
    cfg = strict_json(bounded_file(args.model_config, 1024 * 1024))
    if (
        not isinstance(cfg, dict)
        or not isinstance(cfg.get("models"), dict)
        or not isinstance(cfg["models"].get("providers"), dict)
    ):
        raise Invalid("model provider map required")
    providers = cfg.get("models", {}).get("providers", {})
    if any(
        not isinstance(pcfg, dict)
        or not isinstance(pcfg.get("models"), dict)
        or any(not isinstance(mcfg, dict) for mcfg in pcfg["models"].values())
        for pcfg in providers.values()
    ):
        raise Invalid("model option maps required")
    for pair in args.pair:
        p, m = pair.split("/")
        if p not in providers or m not in providers[p].get("models", {}):
            raise Invalid("pair not configured")
    # General fake/self-test providers are permitted here. The paid wrapper renders
    # and checks the exact single-provider config and credential-free leaf boundary.
    if len(args.model_secret) > 1 or any(
        s != "evalgate=env:SPARKLES_EVAL_GATE_TOKEN" for s in args.model_secret
    ):
        raise Invalid("only evaluation gate secret reference is allowed")
    qset = load_questions(args)
    if args.timeout < qset.get("goldTimeoutSecs", 0):
        raise Invalid("query timeout is below the one the gold answers were made with")
    out = (
        pathlib.Path(args.out)
        if args.out
        else pathlib.Path(tempfile.gettempdir())
        / ("sparkles-eval-" + os.urandom(16).hex())
    )
    if (
        not out.is_absolute()
        or out.resolve() != out
        or ROOT == out
        or ROOT in out.parents
    ):
        raise Invalid("new absolute output outside repository required")
    out.mkdir(mode=0o700)  # Exclusive, including existing empty directories/symlinks.
    return qset, out


def killed(record, directory):
    """Whether a child ended by SIGKILL, or by SIGABRT after a failed allocation."""
    code = record.get("returncode")
    if type(code) is not int or code >= 0:
        return False
    if -code == signal.SIGKILL:
        return True
    if -code == signal.SIGABRT:
        try:
            with (pathlib.Path(directory) / "stderr").open("rb") as f:
                return b"memory allocation of" in f.read(1024 * 1024)
        except OSError:
            return False
    return False


def memory_wrapper(limit):
    """The argv prefix that runs a child in its own systemd scope with `limit` of
    memory and no swap, so that the kernel kills that child alone when it passes the
    limit. The scope's cgroup holds the child's whole process group. `env -u` drops
    the runtime directory that systemd-run needs from the child's environment."""
    if not limit:
        return []
    if not re.fullmatch(r"[1-9][0-9]*[KMGT]?", limit):
        raise Invalid("memory limit like 4G required")
    run, env = shutil.which("systemd-run"), shutil.which("env")
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not run or not env or not runtime:
        raise Invalid("a per-child memory limit needs systemd-run and a user session")
    return [
        env,
        "XDG_RUNTIME_DIR=" + runtime,
        run,
        "--user",
        "--scope",
        "--quiet",
        "--collect",
        "-p",
        "MemoryMax=" + limit,
        "-p",
        "MemorySwapMax=0",
        "-p",
        "OOMPolicy=continue",
        "--expand-environment=no",  # a question or query can hold "${PATH}"
        "--",
        env,
        "-u",
        "XDG_RUNTIME_DIR",
    ]


class Runner:
    def __init__(self, args, qset, out_dir=None, proxy=None, deadline=None):
        self.args, self.qset, self.proxy = args, qset, proxy
        self.out = pathlib.Path(out_dir or args.out)
        self.deadline = deadline or (
            time.monotonic() + args.phase_deadline if args.phase_deadline else math.inf
        )
        self.loc = pathlib.Path(args.loc).resolve() if args.loc else None
        self.data = (
            None
            if self.loc
            else (pathlib.Path(args.set).parent / qset["data"]).resolve()
        )
        self.header = prefix_header(qset.get("prefixes", {}))
        self.gold_cache, self.serial = {}, 0
        self._tl = threading.local()
        self.serial_lock = threading.Lock()
        self.last_got = None
        self.wrap = memory_wrapper(getattr(args, "child_memory_max", None))
        self.errata = guarded.load_errata()
        self.policy = getattr(args, "scoring_policy", None) or POLICY
        if self.policy not in POLICIES:
            raise Invalid("unknown scoring policy")
        self.clarifications = getattr(args, "clarifications", None) or "answer"
        if self.clarifications not in CLARIFICATIONS:
            raise Invalid("unknown clarification policy")
        self.env = leaf_environment(
            {"SPARKLES_EVAL_GATE_TOKEN": proxy.token} if proxy else None
        )
        cfg = strict_json(bounded_file(args.model_config, 1024 * 1024))
        self.cli_priced_pairs = set()
        for provider, pcfg in cfg.get("models", {}).get("providers", {}).items():
            for model, mcfg in pcfg.get("models", {}).items():
                price = mcfg.get("pricing", pcfg.get("pricing"))
                if isinstance(price, dict) and all(
                    type(price.get(k)) in (int, float)
                    and math.isfinite(price[k])
                    and price[k] >= 0
                    for k in ("inputPerMTok", "outputPerMTok")
                ):
                    self.cli_priced_pairs.add(provider + "/" + model)

    @property
    def last_record(self):
        return getattr(self._tl, "last_record", None)

    @last_record.setter
    def last_record(self, value):
        self._tl.last_record = value

    def check(self):
        if time.monotonic() >= self.deadline:
            raise HarnessFault("phase deadline expired")

    def refusals(self):
        return self.proxy.cap_refusals if self.proxy else 0

    def source_args(self, ask=False):
        if self.loc:
            return ["--loc", str(self.loc)]
        return ["--data", str(self.data)] + (["--text"] if ask else [])

    def spawn(self, argv, label, child_limit=None, wrap=False):
        """Run one child. `wrap` puts an Ask child in its own memory-limited scope;
        the harness's own queries run without one."""
        self.check()
        with self.serial_lock:
            self.serial += 1
            directory = self.out / f"{self.serial:05d}-{label}"
        record = capture_child(
            (self.wrap if wrap else []) + argv,
            directory,
            min(
                self.deadline,
                time.monotonic()
                + (child_limit or self.args.deadline)
                + QUERY_GRACE_SECONDS,
            ),
            self.env,
        )
        self.last_record = record
        if "pid" in record and not record["cleanup"]:
            # The census could not show that the child's group is gone.
            raise HarnessFault("child cleanup unconfirmed")
        return record, directory

    def execute(self, argv, label, child_limit=None):
        record, directory = self.spawn(argv, label, child_limit)
        result = parse_child(record, directory)
        if not isinstance(result, dict):
            raise Invalid("final result object required")
        return result, record

    def query(self, text, label="query"):
        offline_query(self.header + text)
        result, record = self.execute(
            [
                self.args.sparkles,
                "query",
                *self.source_args(),
                "--results",
                "json",
                "--timeout",
                str(self.args.timeout),
                "--outbound-block-private",
                "--outbound-allow",
                "no-remote-eval.invalid",
                self.header + text,
            ],
            label,
            self.args.timeout,
        )
        return answer_set(result), record

    def gold(self, q):
        if q["id"] not in self.gold_cache:
            self.gold_cache[q["id"]] = self.query(q["gold"], "gold")[0]
        return self.gold_cache[q["id"]]

    def classify(self, record, directory):
        """Return the Ask object and a failure status, or raise for harness faults.

        A provider error, refusal, Ask timeout or unusable draft is a measured
        failure of the pipeline and is scored. Only a child that cannot be trusted
        at all, such as one that is not cleaned up or exits with an unknown status,
        stops the run.
        """
        if "pid" not in record:
            raise HarnessFault("child did not start")
        if record["timeout"]:
            if time.monotonic() >= self.deadline:
                raise HarnessFault("phase deadline expired")
            return {"outcome": "error", "error": {"code": "timeout"}}, "timeout"
        if record["byteCap"]:
            return {"outcome": "error", "error": {"code": "output-cap"}}, (
                "invalid_output"
            )
        if killed(record, directory):
            # The kernel's OOM killer, a memory cap or an operator ended this Ask.
            # Its generated query is the likely cause, so it is a measured failure
            # of the case and the run goes on.
            code = -record["returncode"]
            return {"outcome": "error", "error": {"code": "killed", "signal": code}}, (
                "killed"
            )
        if record["returncode"] not in (0, 2):
            raise Invalid("child execution incomplete")
        out = validate_ask_record(
            strict_json(bounded_file(directory / "stdout", 4 * 1024 * 1024))
        )
        if record["returncode"] == 2 and out.get("outcome") != "error":
            raise Invalid("child execution incomplete")
        return self.classify_output(out)

    @staticmethod
    def classify_output(out):
        """The Ask object and its failure status, from the object alone."""
        if out.get("outcome") == "error":
            steps = (out.get("usage") or {}).get("steps") or []
            if (out.get("error") or {}).get("code") == "timeout":
                return out, "timeout"
            if (out.get("error") or {}).get("code") == "budget-exceeded":
                return out, "budget_exceeded"  # The Ask token budget, a measured limit.
            if any(s.get("outcome") == "refusal" for s in steps):
                return out, "refusal"
            return out, "provider_error"
        semantic_failed = (
            out.get("outcome") == "failed"
            and not out.get("error")
            and any(
                i.get("severity") == "error"
                for i in ((out.get("result") or {}).get("issues") or [])
            )
        )
        if (
            out.get("outcome")
            in (
                "answered",
                "empty",
                "clarify",
                "unanswerable",
                "not-run",
            )
            or semantic_failed
        ):
            return out, None
        return out, "invalid_output"

    def ask_command(self, pair, q, config=None, clarification=None):
        cmd = [
            self.args.sparkles,
            "ask",
            *self.source_args(ask=True),
            self.qset.get("dataset", "data"),
            q["question"],
        ] + self.ask_flags(pair, config)
        if clarification is not None:
            # One argument, so a value that starts with a dash is never an option.
            cmd.append("--clarification=" + clarification)
        return cmd

    def batch_command(self, pair, jobs):
        """One `sparkles ask --questions -` child that asks every case of a pair."""
        return [
            self.args.sparkles,
            "ask",
            *self.source_args(ask=True),
            self.qset.get("dataset", "data"),
            "--questions",
            "-",
            "--jobs",
            str(jobs),
        ] + self.ask_flags(pair)

    def ask_flags(self, pair, config=None):
        cmd = [
            "--json",
            "--deadline",
            str(self.args.deadline),
            "--timeout",
            str(self.args.timeout),
            "--max-tokens",
            str(self.args.max_tokens),
            "--max-rows",
            "1000",
            "--model-config",
            str(config or self.args.model_config),
        ]
        if pair is not None:
            for role in ("draft", "repair", "summarize"):
                cmd += ["--pair", role + "=" + pair]
        for secret in self.args.model_secret:
            cmd += ["--model-secret", secret]
        if self.args.allow_loopback:
            cmd += ["--outbound-allow", "127.0.0.1/32"]
        return cmd

    def ask(self, pair, q, config=None):
        refused = self.refusals()
        record, directory = self.spawn(self.ask_command(pair, q, config), "ask", wrap=True)
        out, failure = self.classify(record, directory)
        wall = record["elapsedSeconds"]
        if (
            not failure
            and self.clarifications == "answer"
            and q["kind"] == "answerable"
            and out.get("outcome") == "clarify"
            and not (self.proxy and self.refusals() > refused)
        ):
            out, record, failure, wall = self.answer_clarification(
                pair, q, config, out, record, wall
            )
        if self.proxy and self.refusals() > refused:
            failure = "budget_refused"
        if failure:
            out["evalFailure"] = failure
        out["wallSeconds"] = wall
        out["execution"] = record
        # The SDK reports zero when pricing is unconfigured. Never call that a
        # known free answer. Preserve the raw SDK value in stdout as a diagnostic.
        out["cliEstimatedCostKnown"] = self.proxy is None and all(
            p in self.cli_priced_pairs for p in ([pair] if pair else self.args.pair)
        )
        return out

    def answer_clarification(self, pair, q, config, first, record, wall):
        """Answer the pipeline's clarification from the gold query and ask again.

        `choose_clarification` only ever answers with a value the pipeline offered.
        The second Ask is the one scored, and the first one's clarification, answer,
        execution and usage are kept beside it. Its usage is added to the second's,
        and the case's ledger cost already covers both.
        """
        choice = choose_clarification(first.get("clarify"), self.header + q["gold"])
        if choice is None:
            first["clarification"] = {"basis": "unusable"}
            return first, record, None, wall
        record2, directory = self.spawn(
            self.ask_command(pair, q, config, choice["answer"]), "ask-clarified", wrap=True
        )
        out, failure = self.classify(record2, directory)
        clarify = first.get("clarify") or {}
        out["clarification"] = {
            "id": clarify.get("id"),
            "question": clarify.get("question"),
            "choices": clarify.get("choices"),
            **choice,
            "firstExecution": record,
            "firstUsage": first.get("usage"),
        }
        usage, before = dict(out.get("usage") or {}), first.get("usage") or {}
        for field in ("inputTokens", "outputTokens"):
            if type(before.get(field)) is int:
                usage[field] = usage.get(field, 0) + before[field]
        if before.get("estimatedCost") is not None:
            later = usage.get("estimatedCost")
            usage["estimatedCost"] = (
                later + before["estimatedCost"] if later is not None else None
            )
        if usage:
            out["usage"] = usage
        return out, record2, failure, wall + record2["elapsedSeconds"]

    def first_draft(self, q, out):
        attempts = out.get("attempts")
        if (
            not isinstance(attempts, list)
            or not attempts
            or not isinstance(attempts[0], dict)
        ):
            return {"status": "unknown", "reason": "no_retained_first_attempt"}
        first = attempts[0]
        issues = (first.get("check") or {}).get("issues", [])
        if any(i.get("severity") == "error" for i in issues):
            return {"status": "incorrect", "reason": "check_invalid"}
        query = first.get("query")
        if not isinstance(query, str) or not query:
            return {"status": "unknown", "reason": "no_runnable_first_query"}
        query_sha = hashlib.sha256((self.header + query).encode()).hexdigest()
        try:
            first_result, record = self.query(query, "first-query")
            correct, _, _ = score_sets(
                self.gold(q), first_result, self.check, self.policy
            )
            return {
                "status": "correct" if correct else "incorrect",
                "reason": "complete_strict_comparison",
                "querySha256": query_sha,
                "execution": record,
            }
        except OfflinePolicy:
            return {
                "status": "unknown",
                "reason": "offline_policy_exclusion",
                "querySha256": query_sha,
            }
        except HarnessFault:
            raise
        except (Invalid, OSError):
            return {
                "status": "unknown",
                "reason": "probe_incomplete",
                "querySha256": query_sha,
                "execution": self.last_record,
            }

    def score(self, q, out):
        self.last_got = None
        ok, scores, detail = self.score_one(q, out)
        detail["guarded"] = self.score_guarded(q, ok, detail)
        if q.get("orderMatters") is True:
            # The source scores this question's row order, and this scorer compares
            # sets of rows, so the report marks it.
            detail["orderNotScored"] = True
        return ok, scores, detail

    def safe_iri(self, iri):
        return not any(c in iri for c in '<>"{}|^`\\') and not any(
            c.isspace() for c in iri
        )

    def labels(self, iris, texts):
        """The label texts of `iris` among `texts`, from the set's data. A label
        names one IRI only when every IRI's labels were read, so a lookup that skips
        an IRI, passes a cap or fails returns no labels at all."""
        found = {}
        if len(iris) > 400 or not all(self.safe_iri(i) for i in iris):
            return found
        texts = texts[:200]
        if not iris or not texts:
            return found
        strings = ", ".join(json.dumps(t, ensure_ascii=False) for t in texts)
        preds = " ".join(f"<{p}>" for p in guarded.LABEL_PREDICATES)
        for k in range(0, len(iris), 100):
            values = " ".join(f"<{i}>" for i in iris[k : k + 100])
            text = (
                f"SELECT ?s ?l WHERE {{ VALUES ?s {{ {values} }} VALUES ?p {{ {preds} }} "
                "{ ?s ?p ?l } UNION { GRAPH ?g { ?s ?p ?l } } "
                f"FILTER(isLiteral(?l) && STR(?l) IN ({strings})) }}"
            )
            try:
                rel, _ = self.query(text, "labels")
            except HarnessFault:
                raise
            except Invalid:
                return {}
            for row in rel.rows:
                if row[0][0] == "uri" and row[1][0] in ("literal", "lang"):
                    found.setdefault(row[0][1], set()).add(row[1][1])
        return found

    def predicates(self, iris):
        """The subset of `iris` used as a predicate in the set's data, or None."""
        if not all(self.safe_iri(i) for i in iris):
            return None
        if not iris:
            return set()
        values = " ".join(f"<{i}>" for i in iris)
        text = (
            f"SELECT DISTINCT ?p WHERE {{ VALUES ?p {{ {values} }} "
            "FILTER EXISTS { { ?s ?p ?o } UNION { GRAPH ?g { ?s ?p ?o } } } }"
        )
        try:
            rel, _ = self.query(text, "predicates")
        except HarnessFault:
            raise
        except Invalid:
            return None
        return {row[0][1] for row in rel.rows if row[0][0] == "uri"}

    def score_guarded(self, q, strict_ok, strict_detail):
        """The secondary score under `guarded.POLICY_V3`, beside the strict one."""
        out = {"policy": guarded.POLICY_V3, "errata": guarded.ERRATA_VERSION}
        if q["kind"] != "answerable":
            return dict(out, correct=bool(strict_ok))
        gold = self.gold(q)
        excluded = guarded.errata_exclusion(
            q, gold, self.errata, self.qset.get("dbpediaRelease")
        )
        if excluded:
            return dict(out, correct=False, excluded=excluded)
        if type(gold) is bool:
            return dict(out, correct=bool(strict_ok))
        gold2, dropped_gold = guarded.drop_empty(gold)
        if gold.rows and not gold2.rows:
            return dict(
                out,
                correct=False,
                excluded={
                    "rule": "empty-strings-only",
                    "reason": "every gold row holds an empty string",
                },
            )
        got = self.last_got
        if got is None or type(got) is bool:
            return dict(out, correct=False, status=strict_detail.get("status"))
        got2, dropped_got = guarded.drop_empty(got)
        detail = {"droppedEmptyGoldRows": dropped_gold, "droppedEmptyAnswerRows": dropped_got}
        ok, cmp = guarded.compare(gold2, got2, self.check)
        if not ok and cmp.get("status") is None:
            iris, texts = guarded.label_requests(gold2, got2)
            labels = self.labels(iris, texts) if iris and texts else {}
            found = guarded.lenient_compare(gold2, got2, labels, self.check)
            if found:
                ok, cmp, detail["lenient"], gold2, got2 = found
        detail.update(cmp)
        if ok and cmp.get("extraColumns"):
            detail["flags"] = guarded.flags(gold2, got2, cmp, self.predicates)
        return dict(out, correct=bool(ok), **detail)

    def score_one(self, q, out):
        kind, outcome = q["kind"], out.get("outcome")
        failed = out.get("evalFailure")
        if kind in ("clarify", "unanswerable"):
            ok = outcome == kind and not failed
            detail = {"kind": kind}
            if failed:
                detail["status"] = failed
            return ok, (float(ok),) * 3, detail
        first = self.first_draft(q, out)
        gold = self.gold(q)

        def failure(status):
            detail = (
                {"kind": "ask", "match": False}
                if type(gold) is bool
                else {
                    "kind": "select",
                    "intersection": 0,
                    "goldRows": len(gold.rows),
                    "gotRows": 0,
                }
            )
            detail.update(status=status, firstDraft=first)
            return False, (0.0, 0.0, 0.0), detail

        query = (out.get("result") or {}).get("query")
        if failed:
            return failure(failed)
        if outcome not in ("answered", "empty"):
            return failure("pipeline_" + str(outcome))
        if not isinstance(query, str) or not query:
            return failure("missing_query")
        try:
            got, _ = self.query(query)
        except HarnessFault:
            raise
        except Invalid:
            return failure("candidate_query_failure")
        self.last_got = got
        ok, scores, detail = score_sets(gold, got, self.check, self.policy)
        detail["firstDraft"] = first
        return ok, scores, detail


def ratio(n, d):
    return {"numerator": n, "denominator": d, "value": n / d if d else None}


def summarize_pair(pair, qs, answers, scores):
    n = len(qs)
    answerable = [i for i, q in enumerate(qs) if q["kind"] == "answerable"]
    correct = sum(scores[i][0] for i in answerable)
    invoked = [
        i
        for i in answerable
        if (answers[i].get("result") or {}).get("attempt", 1) > 1
        or any(a.get("role") == "repair" for a in answers[i].get("attempts", []))
        or any(
            s.get("role") == "repair"
            for s in (answers[i].get("usage") or {}).get("steps", [])
        )
    ]
    failed_first = [
        i
        for i in answerable
        if scores[i][2].get("firstDraft", {}).get("status") == "incorrect"
    ]
    unknown_first = [
        i
        for i in answerable
        if scores[i][2].get("firstDraft", {}).get("status", "unknown") == "unknown"
    ]
    repaired = [i for i in invoked if scores[i][0] and i in failed_first]
    costs = [(a.get("usage") or {}).get("estimatedCost") for a in answers]
    cost = (
        sum(costs)
        if all(type(v) in (int, float) and math.isfinite(v) and v >= 0 for v in costs)
        and all(a.get("cliEstimatedCostKnown", True) for a in answers)
        else None
    )
    nano = [a.get("ledgerNanodollars") for a in answers]
    ledger_cost = (
        sum(nano) / 1e9 if answers and all(type(v) is int for v in nano) else None
    )
    # A question counts as asked when the pipeline asked, even when the clarification
    # was then answered and the second Ask was scored, and in a cascade when any pair
    # it tried asked.
    clar = [
        i
        for i, a in enumerate(answers)
        if a.get("outcome") == "clarify"
        or "clarification" in a
        or a.get("cascadeAsked")
    ]

    def records(a):
        if "cascadeClarifications" in a:
            return a["cascadeClarifications"]
        return [a["clarification"]] if "clarification" in a else []

    answered = [
        i
        for i in answerable
        if any(c.get("basis") != "unusable" for c in records(answers[i]))
    ]
    basis = {}
    for a in answers:
        for c in records(a):
            basis[c.get("basis")] = basis.get(c.get("basis"), 0) + 1
    refusal = [i for i, q in enumerate(qs) if q["kind"] == "unanswerable"]
    selects = [scores[i][2] for i in answerable if scores[i][2]["kind"] == "select"]
    common = sum(s["intersection"] for s in selects)
    # A projected answer is compared by its projected rows.
    pden = sum(s.get("projectedRows", s["gotRows"]) for s in selects)
    rden = sum(s["goldRows"] for s in selects)
    # Correct answers that matched only after their extra columns were set aside.
    projected = sum(
        bool(scores[i][0] and scores[i][2].get("extraColumns")) for i in answerable
    )
    g = [scores[i][2].get("guarded") or {} for i in answerable]
    g_excluded = [qs[i]["id"] for i, d in zip(answerable, g) if d.get("excluded")]
    g_correct = sum(bool(d.get("correct")) for d in g)
    # A pass flagged for a predicate column or for rows its projection drops is set
    # apart. A rival column is only reported, since a related resource beside the
    # answer, such as each country beside its capital, raises it as well.
    g_flagged = [
        qs[i]["id"]
        for i, d in zip(answerable, g)
        if d.get("correct") and set(d.get("flags") or ()) & guarded.SET_APART
    ]
    g_flags = {}
    for d in g:
        if d.get("correct"):
            for f in d.get("flags") or []:
                g_flags[f] = g_flags.get(f, 0) + 1
    g_den = len(answerable) - len(g_excluded)
    guarded_row = {
        "guardedPolicy": guarded.POLICY_V3,
        "goldErrata": guarded.ERRATA_VERSION,
        "executionAccuracyGuarded": ratio(g_correct, g_den),
        "executionAccuracyGuardedUnflagged": ratio(g_correct - len(g_flagged), g_den),
        "guardedExcluded": g_excluded,
        "guardedFlaggedPasses": g_flagged,
        "guardedFlags": g_flags,
        "guardedLenientPasses": [
            qs[i]["id"] for i, d in zip(answerable, g) if d.get("correct") and d.get("lenient")
        ],
    }
    return [
        {
            "pair": pair,
            "role": "demo-pipeline",
            **guarded_row,
            "questions": n,
            "executionAccuracy": ratio(correct, len(answerable)),
            "executionAccuracyEqualWidth": ratio(correct - projected, len(answerable)),
            "correctByProjection": projected,
            "endToEndSuccess": ratio(sum(s[0] for s in scores), n),
            "repairRate": ratio(len(repaired), len(answerable)),
            "repairConditional": ratio(len(repaired), len(failed_first)),
            "repairInvoked": ratio(len(invoked), len(answerable)),
            "firstDraftUnknown": ratio(len(unknown_first), len(answerable)),
            "firstDraftIncorrect": ratio(len(failed_first), len(answerable)),
            "clarificationPrecision": ratio(
                sum(qs[i]["kind"] == "clarify" for i in clar), len(clar)
            ),
            "clarificationsAnswered": ratio(len(answered), len(answerable)),
            "clarificationBasis": basis,
            "correctAfterClarification": sum(bool(scores[i][0]) for i in answered),
            "refusalAccuracy": ratio(sum(scores[i][0] for i in refusal), len(refusal)),
            "macroPrecision": statistics.mean(scores[i][1][0] for i in answerable)
            if answerable
            else None,
            "macroRecall": statistics.mean(scores[i][1][1] for i in answerable)
            if answerable
            else None,
            "macroF1": statistics.mean(scores[i][1][2] for i in answerable)
            if answerable
            else None,
            "microPrecision": ratio(common, pden),
            "microRecall": ratio(common, rden),
            "askExact": ratio(
                sum(scores[i][0] for i in answerable if scores[i][2]["kind"] == "ask"),
                sum(scores[i][2]["kind"] == "ask" for i in answerable),
            ),
            "byComplexity": {
                b: ratio(
                    sum(
                        scores[i][0]
                        for i in answerable
                        if bucket(qs[i].get("complexity")) == b
                    ),
                    sum(bucket(qs[i].get("complexity")) == b for i in answerable),
                )
                for b in ("simple", "medium", "complex")
            },
            "repairByComplexity": {
                b: ratio(
                    sum(bucket(qs[i].get("complexity")) == b for i in repaired),
                    sum(bucket(qs[i].get("complexity")) == b for i in answerable),
                )
                for b in ("simple", "medium", "complex")
            },
            "cliEstimatedCostUSD": cost,
            "ledgerCostUSD": ledger_cost,
            "ledgerCostPerCorrectUSD": ledger_cost / correct
            if ledger_cost is not None and correct
            else None,
            "citationChecks": "unjudged",
            "cliInputTokens": sum(
                (a.get("usage") or {}).get("inputTokens", 0) for a in answers
            ),
            "cliOutputTokens": sum(
                (a.get("usage") or {}).get("outputTokens", 0) for a in answers
            ),
        }
    ]


def server_failed(answer):
    """The failure signal that the server itself can see, without any gold answer."""
    return bool(answer.get("evalFailure")) or answer.get("outcome") in (
        "failed",
        "error",
    )


def cascade_cases(pairs, qs, answers, scores):
    """Compute the cascade row offline from the per-pair runs.

    A question moves to the next pair when the server sees the current pair fail,
    which is a failed or errored Ask and never a comparison with the gold answer.
    The last pair's case stands when every pair failed. The cost of a cascaded
    answer includes every pair that was tried. A question that some pair did not
    attempt, because the cost cap ended the run, is left out of the row.
    """
    used, cascade_answers, cascade_scores, tally = [], [], [], {p: 0 for p in pairs}
    for q in qs:
        if any(q["id"] not in answers[p] for p in pairs):
            continue
        tried = []
        for pair in pairs:
            tried.append(pair)
            if not server_failed(answers[pair][q["id"]]):
                break
        chosen = answers[tried[-1]][q["id"]]
        merged = dict(chosen)
        usage = dict(chosen.get("usage") or {})
        spent = [answers[p][q["id"]] for p in tried]
        usage["inputTokens"] = sum(
            (a.get("usage") or {}).get("inputTokens", 0) for a in spent
        )
        usage["outputTokens"] = sum(
            (a.get("usage") or {}).get("outputTokens", 0) for a in spent
        )
        costs = [(a.get("usage") or {}).get("estimatedCost") for a in spent]
        usage["estimatedCost"] = (
            sum(costs) if all(type(c) in (int, float) for c in costs) else None
        )
        merged["usage"] = usage
        ledger = [a.get("ledgerNanodollars") for a in spent]
        merged["ledgerNanodollars"] = (
            sum(ledger) if all(type(v) is int for v in ledger) else None
        )
        merged["cliEstimatedCostKnown"] = all(
            a.get("cliEstimatedCostKnown", True) for a in spent
        )
        # A pair that asked for a clarification and then failed still asked, so the
        # cascade keeps the clarifications of every pair it tried.
        merged["cascadeAsked"] = any(
            a.get("outcome") == "clarify" or "clarification" in a for a in spent
        )
        merged["cascadeClarifications"] = [
            a["clarification"] for a in spent if "clarification" in a
        ]
        used.append(q)
        cascade_answers.append(merged)
        cascade_scores.append(scores[tried[-1]][q["id"]])
        tally[tried[-1]] += 1
    return used, cascade_answers, cascade_scores, tally


def finish_run(report, out_dir, runner, error=None):
    report["complete"] = (
        error is None
        and report["executed"] == report["planned"]
        and not report["budgetStopped"]
        and not report["notRun"]
    )
    report["error"] = error
    report["unattempted"] = report["planned"] - report["attempted"]
    report["goldUnattemptedIds"] = [
        i
        for i in report["goldPlannedIds"]
        if i not in {r["id"] for r in report["goldPreflight"]}
    ]
    report["phaseElapsedSeconds"] = time.monotonic() - report.pop("_started")
    if runner.proxy:
        runner.proxy.set_case(None)
        report["ledger"] = runner.proxy.report()
    with (out_dir / "report.json").open("x") as f:
        json.dump(report, f, indent=2)
        f.write("\n")
    with (out_dir / "report.md").open("x") as f:
        f.write(
            f"# Ask pipelines\n\nStrict RDF-term accuracy uses {runner.policy}.\n\n"
            f"The clarification policy is {runner.clarifications}.\n\n"
        )
        f.write(
            "The run is "
            + ("complete" if report["complete"] else "incomplete")
            + ". Role accuracy and official benchmark scores remain unmeasured.\n"
        )
    return out_dir, report


def case_of(pair, q):
    return hashlib.sha256(
        json.dumps([pair, q["id"]], separators=(",", ":"), ensure_ascii=False).encode()
    ).hexdigest()


# How long past its Ask deadline and the query grace the runner waits for the result
# of the oldest line in flight before it ends the batch child.
BATCH_SLACK_SECONDS = 30


class Batch:
    """One `sparkles ask --questions -` child: lines go to its standard input and its
    results come back one line each, in the order the lines were sent."""

    LINE_CAP = 4 * 1024 * 1024

    def __init__(self, runner, argv, directory):
        self.directory = pathlib.Path(directory)
        self.directory.mkdir(mode=0o700)
        self.started = time.monotonic()
        self.stderr = (self.directory / "stderr").open("xb")
        self.proc = subprocess.Popen(
            runner.wrap + argv,
            env=runner.env,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=self.stderr,
            start_new_session=True,
        )
        self.lines = queue.Queue()
        self.reader = threading.Thread(target=self.read, daemon=True)
        self.reader.start()
        self.record = {"schema": 1, "argv": runner.wrap + argv, "pid": self.proc.pid}
        self.closed = False

    def read(self):
        try:
            while True:
                line = self.proc.stdout.readline(self.LINE_CAP + 1)
                if not line:
                    break
                if len(line) > self.LINE_CAP or not line.endswith(b"\n"):
                    self.lines.put(("overlong", None))
                    return
                self.lines.put(("line", line))
        except (OSError, ValueError):
            pass
        self.lines.put(("eof", None))

    def send(self, obj):
        data = (json.dumps(obj, ensure_ascii=False) + "\n").encode()
        self.proc.stdin.write(data)
        self.proc.stdin.flush()

    def close(self, kill=False):
        """End the child and its group, and return its record."""
        if self.closed:
            return self.record
        self.closed = True
        with contextlib.suppress(OSError, ValueError):
            self.proc.stdin.close()
        if not kill:
            with contextlib.suppress(subprocess.TimeoutExpired):
                self.proc.wait(timeout=30)
        for sig in (signal.SIGTERM, signal.SIGKILL):
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.killpg(self.proc.pid, sig)
        self.record["returncode"] = self.proc.wait()
        self.reader.join(5)
        self.proc.stdout.close()
        self.stderr.close()
        self.record["elapsedSeconds"] = time.monotonic() - self.started
        self.record["stderrSha256"] = digest(self.directory / "stderr")
        (self.directory / "status.json").write_text(json.dumps(self.record, indent=2) + "\n")
        return self.record


def merge_clarified(first, second, choice, wall_first, wall_second):
    """The scored second Ask with the first one's clarification and usage beside it,
    as Runner.answer_clarification builds it."""
    clarify = first.get("clarify") or {}
    second["clarification"] = {
        "id": clarify.get("id"),
        "question": clarify.get("question"),
        "choices": clarify.get("choices"),
        **choice,
        "firstExecution": first.get("execution"),
        "firstUsage": first.get("usage"),
    }
    usage, before = dict(second.get("usage") or {}), first.get("usage") or {}
    for field in ("inputTokens", "outputTokens"):
        if type(before.get(field)) is int:
            usage[field] = usage.get(field, 0) + before[field]
    if before.get("estimatedCost") is not None:
        later = usage.get("estimatedCost")
        usage["estimatedCost"] = (
            later + before["estimatedCost"] if later is not None else None
        )
    if usage:
        second["usage"] = usage
    return second, wall_first + wall_second


def run_batch(runner, proxy, pair, qs, jobs, admit, report, watch):
    """Ask a pair's cases through batch children and return [(q, case_id, answer)]
    in question order.

    The child opens the store and the model configuration once and asks up to `jobs`
    lines at once. The runner keeps at most `jobs` lines in flight, so every line it
    sends starts at once. Each case's line names its own gate token through a model
    secret file, so the proxy books every request to the case that sent it, and the
    ledger holds the case's projected cost before its line is sent. A case whose hold
    does not fit waits for the lines in flight and, with none, ends the run as the cap
    would. Reply lines are held per case and appended in question order. A clarified
    case sends a second line with the chosen answer. When the child dies or a line
    passes its deadline, the cases in flight fail as `killed` or `timeout` and a new
    child asks the rest. `watch(q, answer)` sees each case in question order and
    returns True to stop the run.
    """
    bound = getattr(admit, "case_bound", None)
    ledger = proxy.ledger if proxy else None
    if proxy:
        proxy.ordered_replies = True
    tokens = runner.out / f"tokens-{case_of(pair, {'id': ''})[:12]}"
    tokens.mkdir(mode=0o700, exist_ok=True)
    cases = []  # dicts in question order, for the cases that were sent
    flight = collections.deque()  # (case dict, round, sent at) in the order sent
    stopped, finished, batch, batches = False, 0, None, 0
    limit = runner.args.deadline + QUERY_GRACE_SECONDS + BATCH_SLACK_SECONDS
    i = 0

    def start():
        nonlocal batch, batches
        batches += 1
        with runner.serial_lock:
            runner.serial += 1
            directory = runner.out / f"{runner.serial:05d}-batch"
        batch = Batch(runner, runner.batch_command(pair, jobs), directory)
        report.setdefault("batches", []).append(batch.record)

    def send(c, rnd, clarification=None):
        line = {"id": f"{c['case']}#{rnd}", "question": c["q"]["question"]}
        if clarification is not None:
            line["clarification"] = clarification
        if c["token"]:
            line["modelSecrets"] = [f"evalgate=file:{c['tokenFile']}"]
        batch.send(line)
        flight.append((c, rnd, time.monotonic()))

    def done(c, answer):
        c["answer"] = answer
        if proxy:
            proxy.wait_idle(case=c["case"])
            answer["ledgerNanodollars"] = proxy.case_cost(c["case"])
            proxy.close_case(c["token"])
            ledger.release(c["case"])
        with contextlib.suppress(OSError):
            c["tokenFile"].unlink()

    def fail_flight(status):
        record = batch.close(kill=True)
        while flight:
            c, rnd, _ = flight.popleft()
            code = "killed" if status == "killed" else "timeout"
            out = {"outcome": "error", "error": {"code": code}}
            out["evalFailure"] = status
            out["wallSeconds"] = None
            out["execution"] = {"batch": record["pid"], "round": rnd}
            done(c, out)

    def finalize():
        nonlocal finished, stopped
        while finished < len(cases) and "answer" in cases[finished]:
            c = cases[finished]
            if proxy:
                proxy.flush_replies(c["case"])
            if watch(c["q"], c["answer"]):
                stopped = True
            finished += 1

    try:
        start()
        while True:
            runner.check()
            while not stopped and i < len(qs) and len(flight) < jobs:
                q = qs[i]
                case_id = case_of(pair, q)
                held = True
                if proxy and bound:
                    held = ledger.hold(case_id, bound(pair))
                if not held:
                    if flight:
                        break  # wait for a line in flight to end
                    stopped = True
                    break
                token = proxy.open_case(case_id) if proxy else None
                path = tokens / case_id[:32]
                if token:
                    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                    with os.fdopen(fd, "w") as f:
                        f.write(token)
                c = {"q": q, "case": case_id, "token": token, "tokenFile": path}
                cases.append(c)
                report["attempted"] += 1
                report["attemptedCases"].append(
                    {"case": case_id, "pair": pair, "id": q["id"]}
                )
                send(c, 1)
                i += 1
            if not flight:
                break
            head_sent = flight[0][2]
            try:
                kind, raw = batch.lines.get(
                    timeout=max(0.1, head_sent + limit - time.monotonic())
                )
            except queue.Empty:
                fail_flight("timeout")
                finalize()
                if i < len(qs) and not stopped:
                    start()
                continue
            if kind != "line":
                fail_flight("killed")
                finalize()
                if i < len(qs) and not stopped:
                    start()
                continue
            c, rnd, sent = flight.popleft()
            try:
                obj = strict_json(raw)
                if not isinstance(obj, dict) or obj.get("id") != f"{c['case']}#{rnd}":
                    raise Invalid("batch result out of order")
                obj.pop("id")
                out, failure = Runner.classify_output(validate_ask_record(obj))
            except Invalid:
                batch.close(kill=True)
                raise HarnessFault("batch output invalid") from None
            wall = ((out.get("usage") or {}).get("elapsedMs") or 0) / 1000
            out["execution"] = {"batch": batch.record["pid"], "round": rnd}
            refused = proxy and proxy.refusals_for(c["case"]) > 0
            if (
                rnd == 1
                and not failure
                and not refused
                and runner.clarifications == "answer"
                and c["q"]["kind"] == "answerable"
                and out.get("outcome") == "clarify"
            ):
                choice = choose_clarification(
                    out.get("clarify"), runner.header + c["q"]["gold"]
                )
                if choice is None:
                    out["clarification"] = {"basis": "unusable"}
                else:
                    c["first"], c["firstWall"], c["choice"] = out, wall, choice
                    send(c, 2, choice["answer"])
                    continue
            if rnd == 2:
                out, wall = merge_clarified(c["first"], out, c["choice"], c["firstWall"], wall)
            if refused:
                failure = "budget_refused"
            if failure:
                out["evalFailure"] = failure
            out["wallSeconds"] = wall
            out["cliEstimatedCostKnown"] = False
            done(c, out)
            finalize()
        record = batch.close()
        if record["returncode"] != 0 and not cases[finished:]:
            # Every line was answered, so a failed exit after them is reported only.
            report.setdefault("batchExitStatus", []).append(record["returncode"])
        report["executed"] += sum(1 for c in cases if "answer" in c)
        finalize()
        if i < len(qs):
            report["budgetStopped"] = report["budgetStopped"] or stopped
            report["unattemptedIds"].setdefault(pair, []).extend(q["id"] for q in qs[i:])
        return [(c["q"], c["case"], c["answer"]) for c in cases if "answer" in c]
    except BaseException:
        if batch:
            batch.close(kill=True)
        raise
    finally:
        if proxy:
            proxy.ordered_replies = False
            for c in cases:
                proxy.close_case(c["token"])
                ledger.release(c["case"])
                proxy.flush_replies(c["case"])
        shutil.rmtree(tokens, ignore_errors=True)


def run_matrix(args, proxy=None, prepared=None, admit=None):
    started = time.monotonic()
    qset, out_dir = prepared or validate_args(args)
    qs = qset["questions"]
    runner = Runner(
        args,
        qset,
        out_dir,
        proxy,
        started + args.phase_deadline if args.phase_deadline else None,
    )
    report = {
        "schema": 3,
        "mode": "pipeline",
        "scoringPolicy": runner.policy,
        "clarificationPolicy": runner.clarifications,
        "set": str(args.set),
        "setSha256": digest(args.set),
        "dataSha256": digest(runner.data) if runner.data else None,
        "dataLoc": str(runner.loc) if runner.loc else None,
        "binary": args.sparkles,
        "binarySha256": digest(args.sparkles),
        "modelConfigSha256": digest(args.model_config),
        "evaluatorSha256": digest(__file__),
        "supportSha256": digest(ROOT / "testsuite/ask/eval_support/evaluator.py"),
        "askDeadlineSeconds": args.deadline,
        "askTokenBudget": args.max_tokens,
        "questions": len(qs),
        "selectedQuestionIds": [q["id"] for q in qs],
        "pairs": args.pair,
        "planned": len(qs) * len(args.pair),
        "executed": 0,
        "attempted": 0,
        "attemptedCases": [],
        "scored": 0,
        "budgetStopped": False,
        "unattemptedIds": {},
        "notRun": [],
        "rows": [],
        "cases": [],
        "goldPreflight": [],
        "goldPlannedIds": [q["id"] for q in qs if q["kind"] == "answerable"],
        "_started": started,
    }
    try:
        for q in qs:
            if q["kind"] == "answerable":
                try:
                    gold = runner.gold(q)  # All gold is validated before the first Ask.
                except (Invalid, OSError) as error:
                    report["goldPreflight"].append(
                        {
                            "id": q["id"],
                            "status": "failed",
                            "reason": type(error).__name__,
                            "detail": str(error)
                            if isinstance(error, Invalid)
                            else None,
                            "execution": runner.last_record,
                        }
                    )
                    if isinstance(error, HarnessFault):
                        raise
                    raise GoldFault(f"gold query of {q['id']} failed") from None
                report["goldPreflight"].append(
                    {
                        "id": q["id"],
                        "status": "complete",
                        "querySha256": hashlib.sha256(
                            (runner.header + q["gold"]).encode()
                        ).hexdigest(),
                        "empty": not gold.rows if hasattr(gold, "rows") else False,
                    }
                )
        per_pair = {}
        jobs = getattr(args, "jobs", 1) or 1
        for pair in args.pair:
            done, answers, scores, streak = [], [], [], 0
            per_pair[pair] = ({}, {})
            if report["budgetStopped"] or (admit and not admit(pair, qs)):
                # The projected cost does not fit what is left of the cap.
                report["notRun"].append({"pair": pair, "reason": "budget"})
                report["unattemptedIds"][pair] = [q["id"] for q in qs]
                continue
            def finish_case(q, case_id, answer):
                """Score one asked case in question order. True when the cap ended
                the run."""
                nonlocal streak
                score = runner.score(q, answer)
                report["scored"] += 1
                report["cases"].append(
                    {
                        "case": case_id,
                        "pair": pair,
                        "id": q["id"],
                        "correct": score[0],
                        "prf": score[1],
                        "detail": score[2],
                    }
                )
                with (out_dir / (case_id + ".json")).open("x") as f:
                    json.dump(
                        {"id": q["id"], "answer": answer, "score": score}, f, indent=2
                    )
                if answer.get("evalFailure") == "budget_refused":
                    # The cost cap ended the run. This case is not a measurement.
                    report["budgetStopped"] = True
                    report["unattemptedIds"].setdefault(pair, []).append(q["id"])
                    return True
                streak = (
                    streak + 1 if answer.get("evalFailure") == "provider_error" else 0
                )
                done.append(q)
                answers.append(answer)
                scores.append(score)
                per_pair[pair][0][q["id"]] = answer
                per_pair[pair][1][q["id"]] = score
                if (
                    args.max_consecutive_errors
                    and streak >= args.max_consecutive_errors
                ):
                    # A bad model name, a rejected parameter or a dead key fails every
                    # case for free. That is a harness problem, not a measurement.
                    raise HarnessFault(
                        f"{streak} consecutive provider errors for {pair}"
                    )
                return False

            if getattr(args, "batch", False):
                watched = {"streak": 0}

                def watch(q, answer):
                    # The same stops as finish_case, while the batch still runs.
                    if answer.get("evalFailure") == "budget_refused":
                        return True
                    failed = answer.get("evalFailure") == "provider_error"
                    watched["streak"] = watched["streak"] + 1 if failed else 0
                    return bool(
                        args.max_consecutive_errors
                        and watched["streak"] >= args.max_consecutive_errors
                    )

                # The batch child holds a database directory's lock, so the cases
                # are scored once it has ended.
                results = run_batch(runner, proxy, pair, qs, jobs, admit, report, watch)
                for n, (q, case_id, answer) in enumerate(results):
                    try:
                        finish_case(q, case_id, answer)
                    except HarnessFault:
                        report["drainedCases"] = [
                            {"case": c, "pair": pair, "id": x["id"], "started": True}
                            for x, c, _ in results[n + 1 :]
                        ]
                        for x, c, a in results[n + 1 :]:
                            with (out_dir / (c + ".json")).open("x") as f:
                                json.dump({"id": x["id"], "answer": a, "score": None}, f, indent=2)
                        raise
                qs_left = []
            else:
                qs_left = qs
            for q in qs_left:
                runner.check()
                if report["budgetStopped"]:
                    report["unattemptedIds"].setdefault(pair, []).append(q["id"])
                    continue
                case_id = case_of(pair, q)
                if proxy:
                    proxy.set_case(case_id)
                report["attempted"] += 1
                report["attemptedCases"].append(
                    {"case": case_id, "pair": pair, "id": q["id"]}
                )
                runner.last_record = None
                try:
                    answer = runner.ask(pair, q)
                except (Invalid, OSError):
                    report["failedCase"] = {
                        "case": case_id,
                        "id": q["id"],
                        "execution": runner.last_record,
                    }
                    raise
                finally:
                    if runner.last_record and "pid" in runner.last_record:
                        report["executed"] += 1
                if proxy:
                    proxy.wait_idle()  # A killed child can leave a request in flight.
                    proxy.set_case(None)
                    answer["ledgerNanodollars"] = proxy.case_cost(case_id)
                if finish_case(q, case_id, answer):
                    continue
            row = summarize_pair(pair, done, answers, scores)
            for r in row:
                r["incomplete"] = len(done) < len(qs)
                r["unattemptedQuestions"] = len(qs) - len(done)
                r["failureStatuses"] = failure_counts(answers)
            report["rows"] += row
        if len(args.pair) > 1 and not report["notRun"]:
            used, c_answers, c_scores, tally = cascade_cases(
                args.pair,
                qs,
                {p: per_pair[p][0] for p in args.pair},
                {p: per_pair[p][1] for p in args.pair},
            )
            label = " > ".join(args.pair)
            for r in summarize_pair(label, used, c_answers, c_scores):
                r["derivation"] = "computed from the per-pair runs"
                r["answeredBy"] = tally
                r["incomplete"] = len(used) < len(qs)
                report["rows"].append(r)
        runner.check()
        return finish_run(report, out_dir, runner)
    except (Invalid, OSError) as error:
        # No raw subprocess/provider exception or environment is published here.
        # Harness faults carry fixed messages and never provider text or a key.
        if isinstance(error, Invalid):
            report["errorDetail"] = str(error)
        return finish_run(report, out_dir, runner, type(error).__name__)


def failure_counts(answers):
    counts = {}
    for a in answers:
        status = a.get("evalFailure")
        if status:
            counts[status] = counts.get(status, 0) + 1
    return counts


def parse_args(argv=None):
    ap = argparse.ArgumentParser(
        description=(__doc__ or "Initial Ask evaluator").split("\n")[0]
    )
    ap.add_argument("--model-config")
    ap.add_argument("--model-secret", action="append", default=[])
    ap.add_argument("--pair", action="append", default=[])
    ap.add_argument("--set", default=str(DEFAULT_SET))
    ap.add_argument("--out")
    ap.add_argument("--sparkles", required=True)
    ap.add_argument("--sparkles-sha256")
    ap.add_argument("--loc", help="database directory instead of the set's data file")
    ap.add_argument(
        "--batch",
        action="store_true",
        help="ask every case of a pair through one `sparkles ask --questions` child",
    )
    ap.add_argument(
        "--jobs",
        type=int,
        default=1,
        help="with --batch, the cases asked at once; each is scored in question order",
    )
    ap.add_argument(
        "--child-memory-max",
        help="run each Ask child in its own systemd scope with this memory limit, like 16G",
    )
    ap.add_argument("--deadline", type=float, default=300, help="Ask seconds")
    ap.add_argument("--timeout", type=float, default=5, help="query seconds")
    ap.add_argument("--max-tokens", type=int, default=32768, help="Ask token budget")
    ap.add_argument(
        "--max-consecutive-errors",
        type=int,
        default=5,
        help="stop after this many provider errors in a row, 0 for no limit",
    )
    ap.add_argument(
        "--phase-deadline", type=float, default=0, help="matrix seconds, 0 for none"
    )
    ap.add_argument("--only")
    ap.add_argument(
        "--scoring-policy",
        choices=POLICIES,
        default=POLICY,
        help="the projected-column policy, or the whole-row one of the first paid run",
    )
    ap.add_argument(
        "--clarifications",
        choices=CLARIFICATIONS,
        default="answer",
        help="answer an answerable question's clarification from its gold, or score it",
    )
    ap.add_argument("--allow-loopback", action="store_true")
    ap.add_argument("--self-test", action="store_true")
    return ap.parse_args(argv)


def main():
    args = parse_args()
    if args.self_test:
        from cli_checks import self_test

        return self_test(args)
    _, report = run_matrix(args)
    return 0 if report["complete"] else 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (Invalid, OSError):
        print("eval-ask: refused invalid setup", file=sys.stderr)
        sys.exit(2)
