#!/usr/bin/env python3
"""Root-admitted initial Anthropic demo; one nonrenewable aggregate USD25 wallet.

No runtime admission is included in this repository. Root must supply a SHA-bound
manifest after separate source review and fresh validation. fnox may launch this
owner later; its real key is never inherited by a leaf CLI or written to evidence.
"""

import _sqlite3
import argparse
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import sqlite3
import sys
import threading

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "testsuite/ask/eval_support"))
from anthropic_gate import (
    AUTHORITY_HASHES,
    MODELS,
    Gate,
    Wallet,
    effective_config,
    safe_absolute,
    serve_gate,
)
from evaluator import Invalid, bounded_file, digest, strict_json


def evaluator_module():
    loader = importlib.machinery.SourceFileLoader(
        "eval_ask_initial", str(ROOT / "scripts/eval-ask")
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def runtime_identity():
    return {
        "pythonVersion": sys.version,
        "pythonPrefix": sys.base_prefix,
        "sqliteVersion": sqlite3.sqlite_version,
        "sqliteModuleSha256": digest(_sqlite3.__file__),
        "pythonBinarySha256": digest(pathlib.Path(sys.base_prefix) / "bin/python3"),
    }


def validate_admission(path, expected):
    if digest(path) != expected:
        raise Invalid("admission hash mismatch")
    a = strict_json(bounded_file(path, 65536))
    fields = {
        "schema",
        "paid_run_admitted",
        "run_id",
        "wallet_path",
        "grant_claim_path",
        "local_filesystem",
        "wallet_parent_device",
        "authorities",
        "sources",
        "runtime",
        "binary",
        "binary_sha256",
        "set",
        "set_sha256",
        "data_sha256",
        "only",
        "key_environment",
        "output",
    }
    if (
        not isinstance(a, dict)
        or set(a) != fields
        or a["schema"] != 2
        or a["paid_run_admitted"] is not True
    ):
        raise Invalid("missing runtime admission")
    if (
        not isinstance(a["run_id"], str)
        or not a["run_id"]
        or len(a["run_id"]) > 128
        or a["key_environment"] != "ANTHROPIC_API_KEY"
    ):
        raise Invalid("invalid run identity")
    if (
        not isinstance(a["only"], str)
        or len(a["only"].split(",")) != 17
        or len(set(a["only"].split(","))) != 17
        or "" in a["only"].split(",")
    ):
        raise Invalid("initial admission requires exactly 17 distinct pilot IDs")
    if a["local_filesystem"] not in ("ext4", "xfs", "btrfs"):
        raise Invalid("root must verify local durable filesystem")
    for key in ("wallet_path", "grant_claim_path", "output"):
        p = safe_absolute(a[key])
        if p.exists() or not p.parent.is_dir():
            raise Invalid("fresh wallet/claim/output required")
    if (
        type(a["wallet_parent_device"]) is not int
        or os.stat(pathlib.Path(a["wallet_path"]).parent).st_dev
        != a["wallet_parent_device"]
    ):
        raise Invalid("wallet parent device mismatch")
    if (
        os.stat(pathlib.Path(a["grant_claim_path"]).parent).st_dev
        != a["wallet_parent_device"]
    ):
        raise Invalid("grant claim must share the verified local filesystem")
    if set(a["authorities"]) != set(AUTHORITY_HASHES):
        raise Invalid("authority set mismatch")
    for kind, expected_hash in AUTHORITY_HASHES.items():
        record = a["authorities"][kind]
        if (
            set(record) != {"path", "sha256"}
            or record["sha256"] != expected_hash
            or digest(record["path"]) != expected_hash
        ):
            raise Invalid("stale or unknown authority")
        strict_json(bounded_file(record["path"], 4 * 1024 * 1024))
    sources = [
        "scripts/eval-ask",
        "scripts/eval-ask-anthropic",
        "testsuite/ask/eval_support/evaluator.py",
        "testsuite/ask/eval_support/anthropic_gate.py",
    ]
    if set(a["sources"]) != set(sources) or any(
        digest(ROOT / p) != a["sources"][p] for p in sources
    ):
        raise Invalid("source binding mismatch")
    runtime = a["runtime"]
    if runtime != runtime_identity():
        raise Invalid("runtime binding mismatch")
    if digest(a["binary"]) != a["binary_sha256"] or digest(a["set"]) != a["set_sha256"]:
        raise Invalid("input binding mismatch")
    q = strict_json(bounded_file(a["set"], 4 * 1024 * 1024))
    if digest(pathlib.Path(a["set"]).parent / q["data"]) != a["data_sha256"]:
        raise Invalid("data binding mismatch")
    return a


def main():
    ap = argparse.ArgumentParser(
        description=(__doc__ or "Initial Anthropic evaluation owner").split("\n")[0]
    )
    ap.add_argument("--admission", required=True)
    ap.add_argument("--admission-sha256", required=True)
    args = ap.parse_args()
    a = validate_admission(args.admission, args.admission_sha256)
    mod = evaluator_module()
    # Do all setup/input validation and claim the exclusively new report directory
    # before looking up the admitted credential name. No key discovery/fnox capture.
    ev = mod.parse_args(
        [
            "--sparkles",
            a["binary"],
            "--sparkles-sha256",
            a["binary_sha256"],
            "--set",
            a["set"],
            "--out",
            a["output"],
            "--jobs",
            "1",
            "--deadline",
            "30",
            "--timeout",
            "5",
            "--phase-deadline",
            "900",
            "--allow-loopback",
            "--only",
            a["only"],
            "--model-config",
            a["output"] + "/models.json",
            "--model-secret",
            "evalgate=env:SPARKLES_EVAL_GATE_TOKEN",
        ]
        + [v for m in MODELS for v in ("--pair", "evaluation/" + m)]
    )
    # The endpoint has to exist before config validation; it cannot dispatch until
    # a case is active, and admission is already fully bound before wallet creation.
    wallet = Wallet(
        a["wallet_path"],
        a["grant_claim_path"],
        {
            "run": a["run_id"],
            "admissionSha256": args.admission_sha256,
            "authority": AUTHORITY_HASHES,
        },
    )
    server = None
    thread = None
    try:
        key = os.environ.get(a["key_environment"])
        if not key:
            raise Invalid("admitted credential unavailable")
        gate = Gate(wallet, key)
        server = serve_gate(gate)
        gate.server_port = server.server_port
        config = effective_config(gate)
        # Exact one-provider boundary. Rendered JSON is checked, not an unexamined
        # template that could leave a direct provider or credentials enabled.
        if set(config["models"]["providers"]) != {"evaluation"} or config["models"][
            "providers"
        ]["evaluation"]["allowedModels"] != list(MODELS):
            raise Invalid("effective config mismatch")
        out = safe_absolute(a["output"])
        out.mkdir(mode=0o700)
        with (out / "models.json").open("x") as f:
            json.dump(config, f, indent=2)
        if strict_json(bounded_file(out / "models.json", 65536)) != config:
            raise Invalid("rendered config mismatch")
        # validate_args normally creates out. This directory is already exclusively
        # owned and contains only the rendered gate config, so validate using a
        # separate prospective sibling and retain the actual owned out below.
        prospective = ev.out
        ev.out = str(out) + ".setup-claim"
        qset, setup_claim = mod.validate_args(ev)
        setup_claim.rmdir()
        ev.out = prospective
        thread = threading.Thread(target=server.serve_forever, daemon=False)
        thread.start()
        _, report = mod.run_matrix(ev, gate, (qset, out))
        with (out / "runtime-admission.json").open("x") as f:
            json.dump(
                {
                    "schema": 2,
                    "admissionSha256": args.admission_sha256,
                    "run": a["run_id"],
                    "runtime": a["runtime"],
                    "authority": AUTHORITY_HASHES,
                },
                f,
                indent=2,
            )
        return 0 if report["complete"] else 2
    finally:
        if server:
            if thread:
                server.shutdown()
                thread.join(timeout=2)
            server.server_close()
        wallet.close()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001 -- never expose credential-bearing exceptions
        # Do not interpolate exceptions that could carry an echoed credential.
        print(
            "eval-ask-anthropic: refused or incomplete; inspect bounded nonsecret ledger/status",
            file=sys.stderr,
        )
        sys.exit(2)
